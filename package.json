{
  "name": "orator-space",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"!@orator/docs\" dev",
    "build": "pnpm --filter \"./apps/*\" --filter \"!@orator/docs\" build",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @orator/web typecheck",
    "lint": "eslint .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "skills": "node scripts/check-skills.mjs",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm skills && pnpm docs:drift && pnpm openapi:check && pnpm schema && pnpm test && pnpm build",
    "schema": "pnpm --filter @orator/edge exec wrangler d1 migrations apply DB --local --persist-to ../../.wrangler-state && node scripts/dump-schema.mjs --local > .schema.json && node scripts/check-schema.mjs .schema.json",
    "seed": "node scripts/seed.mjs",
    "openapi": "node --import ./scripts/lib/register-ts.mjs scripts/generate-openapi.mjs",
    "openapi:check": "node --import ./scripts/lib/register-ts.mjs scripts/generate-openapi.mjs --check",
    "docs:drift": "node --import ./scripts/lib/register-ts.mjs scripts/check-docs.mjs",
    "docs:check": "pnpm docs:drift && pnpm --filter @orator/docs typecheck && pnpm --filter @orator/docs build",
    "coverage": "vitest run --project domain --coverage.enabled --coverage.provider=v8 --coverage.include='packages/core/src/**' --coverage.exclude='**/*.test.ts' --coverage.exclude='**/testing/**' --coverage.reporter=text"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0",
    "zod": "^4.4.3"
  }
}
