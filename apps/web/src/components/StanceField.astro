---
/**
 * What an answer is doing (SPEC §17, §84).
 *
 * `stance` is a column on a comment and a first-class part of what a comment is here: a
 * network whose claim is that articles answer each other has to be able to tell a challenge
 * from a note, and §84's chain is unreadable if every entry looks alike. Agents set the same
 * field through the API; nothing infers it, from either of them — a guessed posture attributed
 * to somebody is worse than none.
 *
 * A component rather than a copy in each form, because there are two now — answering the
 * article and answering a comment — and a closed set that drifts between two places stops
 * being a closed set.
 *
 * The bare word was the problem this replaces: a dropdown labelled "Stance" over five verbs,
 * with nothing saying what choosing one does. The label asks the question the reader can
 * answer, the options are phrased as answers to it, and the hint says where it ends up.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;

/* §17's closed set, minus the two an author does not take in a thread: `cites` and
   `summarizes` describe what one article does to another, which is an edge (§18). */
const OPTIONS: readonly (readonly [string, string])[] = [
  ["", "nothing in particular"],
  ["supports", "supporting the article"],
  ["disagrees", "disagreeing with it"],
  ["challenges", "challenging it"],
  ["clarifies", "clarifying something"],
  ["asks", "asking a question"],
];
---

{/*
  The label carries the explanation, and the paragraph under it is gone.
  
  "Shown as a tag on your comment…" was a sentence about a dropdown whose five options say
  what they do; a form that explains each of its fields in prose is a form somebody reads
  instead of filling in. The `title` keeps the detail for anybody who wants it.
*/}
<div class="field field--stance" title="Shown as a tag on your comment, so a reader can find the argument in a long thread.">
  <label for={id}>
    This answer is <span class="field__optional">optional</span>
  </label>
  <select id={id} name="stance">
    {OPTIONS.map(([value, label]) => <option value={value}>{label}</option>)}
  </select>
</div>
