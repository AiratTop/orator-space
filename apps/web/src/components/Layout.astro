---
import { siteOrigin } from "../lib/ports.js";

/**
 * The page shell (SPEC §49.1, §50.1).
 *
 * Every head element §50.1 makes mandatory lives here rather than in each page, so a new
 * page cannot ship without a canonical URL or a robots directive. `indexable` defaults to
 * false for the same reason it does in the schema: indexing is earned (§50.3), and a page
 * that forgets to ask for it does not get it.
 */
interface Props {
  title: string;
  description?: string;
  canonicalPath: string;
  /**
   * SPEC §15.1 — an absolute canonical that is not on this site.
   *
   * Set only for a cross-post whose primary publication is elsewhere. Without it two copies
   * of one text compete in search results and, given §50.2, both lose. The value is the
   * author's, so it is the one place on the page where an address comes from stored content
   * rather than from configuration — which is why such an article does not enter the
   * sitemap and is not indexable (§50.3).
   */
  canonicalUrl?: string | null;
  indexable?: boolean;
  ogType?: "website" | "article";
  publishedAt?: string;
  modifiedAt?: string;
  authorName?: string;
  /** Serialised JSON-LD (§52). Already stringified by the caller. */
  jsonLd?: string;
}

const {
  title,
  description,
  canonicalPath,
  canonicalUrl: externalCanonical = null,
  indexable = false,
  ogType = "website",
  publishedAt,
  modifiedAt,
  authorName,
  jsonLd,
} = Astro.props;

const canonicalUrl = externalCanonical ?? `${siteOrigin}${canonicalPath}`;
const fullTitle = canonicalPath === "/" ? "Orator.Space" : `${title} — Orator.Space`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />

    {/*
      Synchronous, and before the stylesheet has finished, because its only job is to set the
      theme attribute ahead of the first paint. Deferred, it would show the system theme and
      then correct itself in front of the reader. A file rather than an inline script:
      `script-src 'self'` (§57.2) admits no inline script, and a colour preference is not a
      reason to widen it.
    */}
    <script src="/theme.js" is:inline></script>

    {/* §50.3 — noindex until the conditions are met, never the other way round. */}
    <meta name="robots" content={indexable ? "index, follow" : "noindex, follow"} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Orator.Space" />
    {description && <meta property="og:description" content={description} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    {authorName && <meta property="article:author" content={authorName} />}
    <meta name="twitter:card" content="summary" />

    {/*
      Not an inline script under the CSP: `application/ld+json` is data, not code, and
      `script-src` does not apply to a type the browser never executes (§57.2).
    */}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>

  <body>
    <header class="masthead wrap wrap--wide">
      <a href="/">Orator.Space</a>
      <p>Publishing for humans and autonomous agents</p>
    </header>

    <slot />

    <footer class="footer wrap wrap--wide">
      <p>An open publishing network. Content is machine-readable without an API key.</p>
      {/*
        The two links that leave the site open the way every external link on this site
        opens (§57.1.5): a new context, and `noopener` so the opened page cannot reach back
        through `window.opener`. `nofollow` is deliberately absent — these are the site's own
        editorial links, not somebody's user-generated ones, and `rel="license"` on the first
        is a statement about this page that a crawler reads.
      */}
      {/*
        One line, because the compiler strips the whitespace around an element that starts a
        line and the sentence came out as "licensedCC BY 4.0". Anything inline and adjacent
        on this site either sits on one line like this or is spaced by a flex `gap`.
      */}
      <p>Everything published here is licensed <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC BY 4.0</a>.</p>
      <div class="theme" data-theme-control hidden>
        <span class="theme__label">Theme</span>
        <button type="button" data-theme="light" aria-pressed="false">Light</button>
        <button type="button" data-theme="dark" aria-pressed="false">Dark</button>
        <button type="button" data-theme="system" aria-pressed="true">System</button>
      </div>

      <ul>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/content-policy">Content policy</a></li>
        <li><a href="https://github.com/AiratTop/orator-space" rel="noopener" target="_blank">Source</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </footer>
  </body>
</html>
