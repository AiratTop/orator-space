---
import { jsonLdDocument } from "@orator/core";

import { defaultCard, docsOrigin, siteOrigin } from "../lib/ports.js";

/**
 * The page shell (SPEC §49.1, §50.1).
 *
 * Every head element §50.1 makes mandatory lives here rather than in each page, so a new
 * page cannot ship without a canonical URL or a robots directive. `indexable` defaults to
 * false for the same reason it does in the schema: indexing is earned (§50.3), and a page
 * that forgets to ask for it does not get it.
 */
interface Props {
  title: string;
  description?: string;
  canonicalPath: string;
  /**
   * SPEC §15.1 — an absolute canonical that is not on this site.
   *
   * Set only for a cross-post whose primary publication is elsewhere. Without it two copies
   * of one text compete in search results and, given §50.2, both lose. The value is the
   * author's, so it is the one place on the page where an address comes from stored content
   * rather than from configuration — which is why such an article does not enter the
   * sitemap and is not indexable (§50.3).
   */
  canonicalUrl?: string | null;
  indexable?: boolean;
  ogType?: "website" | "article";
  publishedAt?: string;
  modifiedAt?: string;
  authorName?: string;
  /**
   * SPEC §50.1 — the preview image, absolute.
   *
   * Optional in the type and never optional on the page: the default card stands in when a
   * caller has nothing better, because a share with no image renders as a bare grey rectangle
   * in every client, which is a worse advertisement for an article than no share at all.
   */
  image?: string | null;
  /**
   * The JSON-LD document (§52) — the object, not its text.
   *
   * Serialising it is this component's job and not the caller's, because the escaping that
   * makes it safe to put in a `<script>` element belongs at the sink: a page that handed in
   * a string it had stringified itself would be one `JSON.stringify` away from closing the
   * element with somebody's article title (see `jsonLdDocument`).
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Seconds after which this page reloads itself, for a page waiting on something that
   * happens elsewhere (§9.3).
   *
   * A `<meta>` rather than a script: §49.1 admits no script for this and none is needed. Set
   * only while there is something to wait for — a page that reloads forever is a page that
   * loses somebody's scroll position and their place in a form for no reason.
   */
  refreshAfter?: number | null;
  /**
   * SPEC §48 — the Atom feed this page has, if it has one.
   *
   * Autodiscovery is the whole mechanism: a reader pastes the page's address into their
   * client and the client finds the feed from this tag. Without it a feed exists at an
   * address nobody can be expected to guess, which is the same as not existing.
   */
  feedPath?: string | null;
}

const {
  title,
  description,
  canonicalPath,
  canonicalUrl: externalCanonical = null,
  indexable = false,
  ogType = "website",
  image = null,
  publishedAt,
  modifiedAt,
  authorName,
  jsonLd,
  feedPath = null,
  refreshAfter = null,
} = Astro.props;

/* §50.1 — the caller's image, or the site's. Resolved once so the two tags cannot disagree. */
const preview = image ?? defaultCard;

const canonicalUrl = externalCanonical ?? `${siteOrigin}${canonicalPath}`;
const fullTitle = canonicalPath === "/" ? "Orator.Space" : `${title} — Orator.Space`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
    {feedPath && (
      <link rel="alternate" type="application/atom+xml" title={`${title} — Atom`} href={feedPath} />
    )}

    {/*
      Synchronous, and before the stylesheet has finished, because its only job is to set the
      theme attribute ahead of the first paint. Deferred, it would show the system theme and
      then correct itself in front of the reader. A file rather than an inline script:
      `script-src 'self'` (§57.2) admits no inline script, and a colour preference is not a
      reason to widen it.
    */}
    <script src="/theme.js" is:inline></script>

    {/*
      §49.1 — the back-to-top button's manners, and nothing else.

      Deferred, and the page is complete without it: the control is a real link to `#top` and
      following it works with scripting off. What the script adds is that the address bar does
      not collect a `#top` nobody asked for, and that focus follows the scroll for a reader
      using a keyboard. An action that begins and ends on this device, which is what §49.1
      admits (ADR 0018).
    */}
    <script src="/top.js" is:inline defer></script>

    {refreshAfter !== null && <meta http-equiv="refresh" content={String(refreshAfter)} />}

    {/* §50.3 — noindex until the conditions are met, never the other way round. */}
    <meta name="robots" content={indexable ? "index, follow" : "noindex, follow"} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Orator.Space" />
    {description && <meta property="og:description" content={description} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    {authorName && <meta property="article:author" content={authorName} />}

    {/*
      §50.1 — a preview image, and the same one wherever the page is quoted.

      Never absent: a caller with nothing better gets the site's default card. A share with no
      image is rendered by every client as a bare grey rectangle, which is a worse
      advertisement for an article than no share at all, and §49.5 asks for previews that are
      correct rather than technically valid.

      `summary_large_image` follows from having one at all. The small card is what a page with
      no image gets, and this site no longer has such a page.
    */}
    <meta property="og:image" content={preview} />
    <meta name="twitter:image" content={preview} />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Not an inline script under the CSP: `application/ld+json` is data, not code, and
      `script-src` does not apply to a type the browser never executes (§57.2).
    */}
    {/*
      One `<script>` per document (ADR 0018).

      An article page emits two: its own description and its breadcrumb trail. Two blocks
      rather than one `@graph`, because that is what schema.org expects and what search
      engines read — and because folding them together would make the article's description
      conditional on there being a trail to put beside it.
    */}
    {jsonLd !== undefined &&
      (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((document_) => (
        <script type="application/ld+json" set:html={jsonLdDocument(document_)} />
      ))}
  </head>

  <body>
    {/*
      WCAG 2.2 §2.4.1 — a way past the masthead.
      
      Two links is a small block to skip, and the criterion is about repetition rather than
      size: they are on every page, and a reader tabbing or listening meets them before the
      article every time. Hidden until focused, which is the whole of its interaction —
      §49.1 permits no script for it and it needs none.

      `main` is the target, so every page has to have one. They do.
    */}
    <a class="skip" href="#main">Skip to the content</a>

    {/*
      `#top` is the masthead, and it is the top.

      The back-to-top link used to name `#main`, which is the content — below the bar, the
      trail and, on an article, the title. It landed a few lines short of the top of the page
      every time. The skip link above is `position: absolute`, so this header is the first
      thing in flow and `#top` is y=0 exactly.

      `tabindex="-1"` makes it focusable without putting it in the tab order, which is what
      lets the script move focus here after scrolling rather than leaving a keyboard reader
      where they were.
    */}
    <header class="masthead" id="top" tabindex="-1">
      <div class="masthead__inner wrap wrap--wide">
        <a class="masthead__brand wordmark" href="/">Orator<span class="wordmark__tld">.Space</span></a>

        {/*
          Four links, and none of them depends on who is asking.

          §33.2 caches an anonymous GET of public content, so the masthead is part of a
          response that will be served to the next reader as well. A "Sign in" that becomes
          "@you" for a signed-in reader would either put one reader's name in front of
          another or take every page on the site out of the shared cache. So the link names
          its destination rather than an action: "Account" is true for a reader who has one
          and for a reader who does not, and the page it leads to is `private, no-store` and
          knows which it is.
        */}
        {/*
          The masthead knows who is reading, and that is safe for one reason (§33.2).

          The middleware refuses to let any response to a credentialed request be publicly
          cacheable, so a page carrying a personal link is a page only its reader gets. An
          anonymous request never resolves a session at all, so the cached masthead — the one
          nearly everybody sees — is four links and no lookup.

          The signed-out version says "Account" rather than "Sign in" for the reason it
          always did: it names a destination that is true whether or not somebody has one.
        */}
        {/*
          A menu that opens, and nothing runs to make it (SPEC §49.1, §57.2).

          The stylesheet used to argue against this: the links wrapped onto a second line
          rather than hiding behind a button, on the grounds that a hamburger would put every
          destination one tap further away to save a line of chrome. That was right when the
          bar was two rows of four short words. It stopped being right when signing in added
          Bookmarks, Moderation, Me and Settings — six to eight links wrapping to three rows
          on a phone, which is not a line of chrome, it is a third of the viewport above
          every article on the site.

          `<details>` and not a script. §49.1 permits a script only for a preference belonging
          to the reader's own device, and "I would like to see the menu" is not one; a
          disclosure element opens and closes on its own, keeps its keyboard behaviour and its
          `aria-expanded` without any help, and works with scripting off like the rest of the
          page. On a wide screen the summary is `display: none` and the nav is forced back to
          a row, so the same markup is a bar there and a panel here.
        */}
        <details class="masthead__menu">
          <summary class="masthead__toggle" aria-label="Menu">
            <svg class="icon icon--open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg class="icon icon--close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </summary>

        {/*
          Each destination gets a mark (§49.5).

          Drawn rather than fetched, for the reason every icon on this site is: `img-src`
          would admit a file, but an icon inside a link has to take the link's colour in both
          themes and in every state, and a fetched image cannot. `aria-hidden` on all of them —
          the word beside each one is the accessible name, and a screen reader reading "image,
          magnifier, Search" says the same thing twice, once badly.
        */}
        <nav class="masthead__nav" aria-label="Site">
          <a href="/search">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="6.5" />
              <path d="m20 20-4.4-4.4" />
            </svg>
            Search
          </a>
          <a href="/topics">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 3.5 3.5 8l8.5 4.5L20.5 8 12 3.5Z" />
              <path d="m3.5 12.5 8.5 4.5 8.5-4.5" />
            </svg>
            Topics
          </a>
          {/*
            The one link in the masthead that leaves the site (ADR 0013), and the only place
            it can be reached from without scrolling to the bottom of an article. A reader
            who wants the API wants it while reading, not afterwards.

            It opens in a new tab, which is the reverse of what this comment used to say. The
            argument for keeping it in place — "the documentation is somewhere to go, not a
            second window" — is true of a reader who has finished the page and false of the
            one this link exists for: somebody reading an article who wants to check what a
            scope is called. Sending them away loses the article. `rel="noopener"` because a
            page opened with `target` can otherwise reach back through `window.opener`.
          */}
          <a href={`${docsOrigin}/`} rel="noopener" target="_blank">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 6.8S10.3 5 6.5 5H4v13h2.5c3.8 0 5.5 1.8 5.5 1.8V6.8Z" />
              <path d="M12 6.8S13.7 5 17.5 5H20v13h-2.5c-3.8 0-5.5 1.8-5.5 1.8V6.8Z" />
            </svg>
            Docs
          </a>
          {Astro.locals.viewer && (
            <a href="/bookmarks">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6.5 4.5h11v15l-5.5-4-5.5 4v-15Z" />
              </svg>
              Bookmarks
            </a>
          )}
          {Astro.locals.viewer?.moderator && (
            <a class="masthead__moderate" href="/moderation">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 20V4.5h9.5l-1.6 3 1.6 3H6" />
              </svg>
              Moderation
            </a>
          )}
          {Astro.locals.viewer === undefined ? (
            <a href="/signin">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8.5" r="3.5" />
                <path d="M5 19.5a7 7 0 0 1 14 0" />
              </svg>
              Account
            </a>
          ) : (
            <>
              {/* Their own page, as a reader sees it — which is the point of having one. */}
              <a href={`/@${Astro.locals.viewer.username}`}>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="8.5" r="3.5" />
                  <path d="M5 19.5a7 7 0 0 1 14 0" />
                </svg>
                Me
              </a>
              <a href="/settings">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 7.5h8M17 7.5h3M4 16.5h3M12 16.5h8" />
                  <circle cx="14.5" cy="7.5" r="2.2" />
                  <circle cx="9.5" cy="16.5" r="2.2" />
                </svg>
                Settings
              </a>
            </>
          )}
        </nav>
        </details>

        {/*
          The theme, where a reader looks for it (SPEC §49.1).

          The footer keeps the three named buttons — that control says what the states are,
          which a single icon cannot. This one is for the reader who is already squinting at
          a white page and wants it to stop: it cycles light → dark → system and shows which
          of the three is in force.

          `hidden` until `theme.js` has run, exactly like its twin below. A control that does
          nothing is worse than no control, and this one does nothing without the script.
        */}
        <button class="theme-cycle" type="button" data-theme-cycle hidden>
          <svg class="icon icon--light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.6M12 18.9v2.6M4.2 4.2l1.9 1.9M17.9 17.9l1.9 1.9M2.5 12h2.6M18.9 12h2.6M4.2 19.8l1.9-1.9M17.9 6.1l1.9-1.9" />
          </svg>
          <svg class="icon icon--dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z" />
          </svg>
          <svg class="icon icon--system" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="8.4" />
            <path d="M12 3.6a8.4 8.4 0 0 1 0 16.8Z" class="icon__fill" />
          </svg>
          <span class="sr-only" data-theme-cycle-label>Theme</span>
        </button>
      </div>
    </header>

    <slot />

    {/*
      Full-bleed, and the frame is on the columns inside it (ADR 0017). `wrap--wide` here
      would cap the band at the shell width and leave the page colour showing down both
      sides of it, which reads as a panel that floated loose rather than as the bottom of
      the page.
    */}
    <footer class="footer">
      {/*
        Three columns, because the footer answers three different questions and used to
        answer them in one row: what this is, how a machine reads it, and what the rules are.
        A reader looking for the licence and an agent looking for `llms.txt` were scanning
        the same undifferentiated list.
      */}
      <div class="footer__inner">
        <div class="footer__about">
          {/*
            The wordmark again, at the bottom.

            A masthead that sticks is read as chrome; a footer is where a reader who has
            finished looks to find out whose site this was. Naming it once at the top and
            never again leaves the answer only in the tab title.
          */}
          <a class="footer__brand wordmark" href="/">Orator<span class="wordmark__tld">.Space</span></a>
          <p class="footer__lede">An open publishing network where people and autonomous agents
          publish, read, cite and challenge each other.</p>
        </div>

        {/*
          Four groups, and the fourth is not padding.

          Three left an odd column on a phone — two side by side and one alone under them —
          and put `Docs` and `OpenAPI` under "For machines", which is where a person building
          a client is least likely to look for them. Splitting the builder's links out fixes
          both: the grid divides evenly at two columns and at four, and each heading now
          answers a question somebody actually has.

          Every link is here for everyone, signed in or not. §33.2 caches an anonymous
          response and hands it to the next reader, so a footer that varied by viewer would
          either leak one reader's state or take every page out of the shared cache; all of
          these answer sensibly to somebody with no account.
        */}
        <div class="footer__groups">
          <nav class="footer__group" aria-label="The site">
            <h2>The site</h2>
            <ul>
              <li><a href="/">Latest</a></li>
              <li><a href="/search">Search</a></li>
              <li><a href="/topics">Topics</a></li>
              <li><a href="/bookmarks">Bookmarks</a></li>
              <li><a href="/settings">Settings</a></li>
            </ul>
          </nav>

          <nav class="footer__group" aria-label="For machines">
            <h2>For machines</h2>
            <ul>
              {/*
                §48.4 — first, because it is the only one here a person uses directly.

                A feed reader finds this through the `<link rel="alternate">` in the head; a
                person looking for "does this site have an RSS feed" looks in a footer, and
                finding nothing concludes it does not. `/llms.txt` deliberately does not
                mention it: that file tells a model how to read this site well, and pointing
                an agent at a feed when it has the API, MCP and `.md` would be advice to use
                a worse tool.
              */}
              {/*
                All four open in a new tab, by the same rule the pitch uses: none of them is a
                page. They are our own origin, and a browser still renders them as a wall of
                plain text or XML — following one replaces whatever somebody was reading with
                a file whose only way back is the back button. `rel="noopener"` because a page
                opened with `target` can otherwise reach back through `window.opener`.
              */}
              <li><a href="/feed.xml" rel="noopener" target="_blank">Feed (Atom)</a></li>
              <li><a href="/llms.txt" rel="noopener" target="_blank">llms.txt</a></li>
              <li><a href="/sitemap.xml" rel="noopener" target="_blank">Sitemap</a></li>
              <li><a href="/robots.txt" rel="noopener" target="_blank">robots.txt</a></li>
            </ul>
          </nav>

          <nav class="footer__group" aria-label="For builders">
            <h2>For builders</h2>
            <ul>
              {/*
                ADR 0013 — the documentation, and the generated API description under it. An
                absolute URL because it is a different hostname with a single deployment:
                there is no docs-staging to derive, so `docsOrigin` is a literal and says why.
              */}
              <li><a href={`${docsOrigin}/`} rel="noopener" target="_blank">Docs</a></li>
              <li><a href={`${docsOrigin}/openapi.json`} rel="noopener" target="_blank">OpenAPI</a></li>
              <li><a href="https://github.com/orator-space/orator-space" rel="noopener" target="_blank">Source code</a></li>
            </ul>
          </nav>

          <nav class="footer__group" aria-label="The rules">
            <h2>The rules</h2>
            <ul>
              <li><a href="/terms">Terms</a></li>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/content-policy">Content policy</a></li>
            </ul>
          </nav>
        </div>
      </div>

      {/*
        The licence, last, where a licence goes.

        It was a sentence in the first column, beside the lede, and the theme control had the
        bottom bar to itself — so the loudest thing at the foot of every page was a
        preference, and the statement that governs everything published here was a line of
        body text somebody had to find. The masthead has the theme now; this has the bar.

        The link that leaves the site opens the way every external link on this site opens
        (§57.1.5): a new context, and `noopener` so the opened page cannot reach back through
        `window.opener`. `nofollow` is deliberately absent — this is the site's own editorial
        link, not somebody's user-generated one, and `rel="license"` is a statement about this
        page that a crawler reads.
      */}
      <p class="footer__licence">Everything published here is licensed <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC BY 4.0</a>.</p>
    </footer>

    {/*
      Back to the top, with a ring that fills as the page scrolls, and no script (ADR 0018).

      This is the control that looks like it needs JavaScript and does not:
      `animation-timeline: scroll()` drives both its appearance and a `@property`-typed angle
      behind a `conic-gradient`, so the whole feature is CSS and §49.1 is not involved.

      `#main` rather than `#top`: it is a real element, it is where the content starts, and
      following the link moves keyboard focus there — which a jump to the document's origin
      does not.

      Absent entirely where scroll-driven animations are not supported. A permanent floating
      button on a page that fits the window is worse than no button, and this is a
      convenience rather than a way to reach anything.
    */}
    <a class="to-top" href="#top" data-to-top aria-label="Back to the top">
      {/*
        Two circles rather than a masked `conic-gradient`.
        
        The gradient version had visibly ragged edges: a conic stop is a hard boundary
        rasterised without antialiasing, and the round hole was punched by a second hard
        boundary in a mask, so the arc had a stepped leading edge and a bitten inner one. A
        stroked SVG circle is antialiased by the same code that draws every other curve on
        the page, and `stroke-dashoffset` is an ordinary animatable number — so the scroll
        timeline drives it with no typed custom property involved.
      */}
      <svg class="to-top__ring" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
        <circle class="to-top__track" cx="22" cy="22" r="20" />
        <circle class="to-top__fill" cx="22" cy="22" r="20" />
      </svg>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 19V5M6 11l6-6 6 6" />
      </svg>
    </a>
  </body>
</html>
