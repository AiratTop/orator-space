---
import { canonicalPath } from "@orator/core";
import type { FeedPage } from "@orator/core/ports";
import { encodeFeedCursor } from "@orator/protocol";
import Byline from "./Byline.astro";
import Signals from "./Signals.astro";

/**
 * A list of articles (SPEC §49.2, §37.1, §44.2).
 *
 * The links carry cursors rather than page numbers, and they are plain links: the feed has
 * to work with JavaScript switched off (§49.1), and a cursor in the URL is also what makes
 * each page independently cacheable (§33.2).
 *
 * Both directions, and a total. A forward link on its own, with no way back, no position
 * and no sense of how much there is, reads as an infinite corridor — a reader following
 * "older" three times cannot tell whether they are near the end or going in circles. Page
 * numbers are not the answer here (§44.2 rules out offset paging, and for a feed that
 * changes under the reader they would be lying anyway), but a way back and a count are.
 */
interface Props {
  page: FeedPage & { total?: number };
  basePath: string;
  empty: string;
  /**
   * Whether this list is a window onto a larger one.
   *
   * False for search, which returns one ranked page and no cursor (§38.1) — a relevance
   * ordering is a score over an index that changes while it is read, so "older" and "newer"
   * are not meaningful there and a pager saying "that is the oldest" would be a lie about a
   * list that was never chronological.
   */
  paged?: boolean;
  /**
   * Whether the first card is the lead (ADR 0017).
   *
   * The front page and nothing else. A lead is an editorial judgement — "this is the one to
   * read" — and it is only true where the ordering makes it true. Search is ranked by
   * relevance over an index that changes while it is read (§38.1), a profile is one author's
   * work in date order, and giving either a card twice the size of its neighbours would be
   * the layout asserting something the page did not.
   */
  lead?: boolean;
}

const { page, basePath, empty, paged = true, lead = false } = Astro.props;
const href = (param: "before" | "after", cursor: NonNullable<FeedPage["next"]>) =>
  `${basePath}?${param}=${encodeFeedCursor(cursor)}`;

const nextHref = page.next === null ? null : href("before", page.next);
const previousHref = page.previous === null ? null : href("after", page.previous);

/* The end of the feed, which is worth saying rather than leaving as an absent link. */
const atTheEnd = page.next === null && page.cards.length > 0;
---

{page.cards.length === 0 ? (
  <p class="empty">{empty}</p>
) : (
  <ul class={lead ? "feed feed--lead" : "feed"}>
    {page.cards.map((card) => (
      <li class="card">
        <h2 class="card__title"><a href={canonicalPath(card)}>{card.title}</a></h2>
        {card.excerpt && <p class="card__excerpt">{card.excerpt}</p>}

        {/*
          The byline and the conversation on one row, at opposite ends.

          §84 is the reason the second half is here at all: this network's claim is that
          articles answer each other, and a list showing only titles and authors hides the
          one thing that distinguishes it from a list of blog posts. A reader scanning the
          feed can see where the argument is before opening anything.
        */}
        <div class="card__foot">
          <Byline
            author={card.author}
            disclosure={card.authorshipDisclosure}
            publishedAt={card.publishedAt}
            readingTimeSeconds={card.readingTimeSeconds}
            compact
          />
          <Signals conversation={card.conversation} />
        </div>

        {/*
          §22 — where the platform put it, on the row below the byline.

          Below rather than beside: the byline answers "who wrote this" and the topics answer
          "what is it", and interleaving them makes one line of grey text out of two facts a
          reader uses differently. At most three (§22.2), so the row cannot become a wall.
        */}
        {card.topics && card.topics.length > 0 && (
          <ul class="card__topics">
            {card.topics.map((topic) => (
              <li><a href={`/t/${topic.slug}`}>{topic.label}</a></li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
)}

{/*
  A pager with nowhere to go is furniture.

  It rendered whenever the feed was paged and held anything, so a profile with one article
  ended in a rule, "Newest first" on the left and "That is the oldest" on the right — two
  labels that are the answer to a question the reader cannot ask, because neither side is a
  control. Where there is a page to go to the labels earn their place: they say which end of
  the sequence you are at. Where there is not, the whole row goes.
*/}
{paged && page.cards.length > 0 && (previousHref !== null || nextHref !== null) && (
  <nav class="pager" aria-label="Feed pages">
    <span class="pager__side">
      {previousHref !== null ? (
        <a href={previousHref} rel="prev">← Newer</a>
      ) : (
        <span class="pager__at-end">Newest first</span>
      )}
    </span>

    {page.total !== undefined && (
      <span class="pager__count">{page.total} {page.total === 1 ? "article" : "articles"} in total</span>
    )}

    <span class="pager__side pager__side--right">
      {nextHref !== null ? (
        <a href={nextHref} rel="next">Older →</a>
      ) : (
        <span class="pager__at-end">{atTheEnd ? "That is the oldest" : ""}</span>
      )}
    </span>
  </nav>
)}

{paged && previousHref !== null && (
  /* Somewhere to land other than one step back, for a reader several pages down. */
  <p class="pager__home"><a href={basePath}>Back to the latest</a></p>
)}
