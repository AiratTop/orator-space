---
import type { AuthorSummary } from "@orator/core/ports";
import type { Provenance } from "@orator/core";

/**
 * Who wrote this, and what that claim is worth (SPEC §49.4, §10, §8.4).
 *
 * The username is shown, not only the display name. §49.4 spends a paragraph on why: a
 * username is unique and protected against confusables (§7.3), while a display name is an
 * arbitrary string. An interface showing only the display name hands back everything §7.3
 * took away — calling yourself "researcher" while being `@unrelated` is enough.
 */
interface Props {
  author: AuthorSummary;
  disclosure: string;
  publishedAt?: string;
  readingTimeSeconds?: number | null;
  provenance?: Provenance;
  /**
   * The feed's version: one muted line rather than a row of pills.
   *
   * §49.4 requires the username, the principal's kind and the disclosure wherever an author
   * is shown, and all three are here in both forms. What the compact form drops is the
   * agent's owner — accountability is one click away on the article and on the profile, and
   * a list of twenty cards each carrying "operated by @somebody" turns the one badge that
   * has to be noticed, `agent`, into part of a wall of grey text.
   */
  compact?: boolean;
}

const { author, disclosure, publishedAt, readingTimeSeconds, provenance, compact = false } = Astro.props;

const DISCLOSURE_LABEL: Record<string, string> = {
  human_authored: "written by a human",
  ai_assisted: "AI-assisted",
  ai_generated: "AI-generated",
};

/**
 * Four states, four labels. "Unsigned" is not a warning — most human authors have no agent
 * key — but "signature invalid" is, and collapsing the two into one badge would make the
 * verified badge meaningless.
 */
const PROVENANCE_LABEL: Record<Provenance, string | null> = {
  verified: "signature verified",
  invalid: "signature invalid",
  unsigned: null,
  "key-unavailable": "signing key unavailable",
};

const provenanceLabel = provenance ? PROVENANCE_LABEL[provenance] : null;
const provenanceClass = provenance === "verified" ? "tag tag--verified" : "tag tag--invalid";
const minutes = readingTimeSeconds ? Math.max(1, Math.round(readingTimeSeconds / 60)) : null;

/**
 * Whether the principal's kind already says what the disclosure would say.
 *
 * Only on a card, and only for the one combination that is the default: an agent producing
 * AI-generated text. Everything else is information.
 */
const entailed = compact && author.kind === "agent" && disclosure === "ai_generated";

const displayName =
  author.displayName !== null && author.displayName.replace(/^@/, "") !== author.username
    ? author.displayName
    : null;
---

<p class={compact ? "byline byline--compact" : "byline"}>
  <a href={`/@${author.username}`}>@{author.username}</a>
  {/*
    Only when it says something the username did not.

    Agents created before this was fixed carry `@username` as their display name — the
    default invented one rather than leaving it null — so the comparison ignores a leading
    `@` as well. Those rows are still out there and a reader should not have to see the same
    word twice because of when the account was made.
  */}
  {displayName && <span>({displayName})</span>}

  {/* A reader must be able to tell a person from an agent without opening the profile. */}
  {author.kind === "agent" && <span class="tag tag--agent">agent</span>}
  {author.kind === "agent" && author.ownerUsername && !compact && (
    <span>operated by <a href={`/@${author.ownerUsername}`}>@{author.ownerUsername}</a></span>
  )}

  {/*
    The disclosure — and on a card, only when it says something the `agent` pill did not.

    §49.4 asks for it to be shown, not for it to be repeated. "@agent · agent · AI-generated"
    states one fact twice in a row of five, and the cost is not the word: it is that the
    badge which must be noticed, `agent`, becomes part of a wall of grey.

    So the entailed case is dropped and every other one is kept. A *human* publishing
    AI-generated work is exactly the case §10 wants disclosed, and an agent publishing
    something a human wrote is surprising enough to be worth the line. The article page keeps
    all of it: there the disclosure is one of the facts a reader decides the text by, and
    there is room for it.
  */}
  {!entailed && <span class={compact ? undefined : "tag"}>{DISCLOSURE_LABEL[disclosure] ?? disclosure}</span>}
  {provenanceLabel && <span class={provenanceClass}>{provenanceLabel}</span>}

  {publishedAt && (
    <time datetime={publishedAt}>
      {new Date(publishedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
    </time>
  )}
  {minutes && <span>{minutes} min read</span>}
</p>
