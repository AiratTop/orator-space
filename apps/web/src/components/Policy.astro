---
import { renderMarkdown } from "@orator/core";
import Layout from "./Layout.astro";
import Icon from "./Icon.astro";
import { siteHost } from "../lib/ports.js";
import type { Policy } from "../lib/policies.js";

interface Props {
  policy: Policy;
}

const { policy } = Astro.props;

/** §48's three policy pages, each with its own mark. */
const ICON: Record<string, string> = {
  terms: "terms",
  privacy: "privacy",
  "content-policy": "policy",
};

/**
 * A policy page (SPEC §61.1).
 *
 * Indexable, unlike almost everything else the Layout renders. §50.3 makes indexing
 * something an *article* earns, because an index full of near-duplicates and stubs serves
 * nobody; the licence a whole network publishes under is the opposite case — somebody
 * searching for it should find it, and a model deciding whether it may use this corpus
 * should be able to reach the answer without crawling the repository.
 */
const rendered = renderMarkdown(policy.body, { siteHost });
if (!rendered.ok) throw new Error(`the ${policy.slug} policy did not render: ${rendered.reason}`);
---

<Layout
  title={policy.title}
  description={policy.description}
  canonicalPath={`/${policy.slug}`}
  indexable={true}
  modifiedAt={`${policy.updated}T00:00:00.000Z`}
>
  <main id="main" class="wrap">
    <article class="prose">
      {/*
        The mark that stands for this policy, from the same set the masthead uses.
        
        Mapped from the slug rather than passed in as a prop: the three policies are a closed
        set (§48, `policies.ts`), and a prop would let a fourth page be added with the wrong
        mark or none. An unknown slug throws in `Icon.astro`, which is the right moment to
        find out.
      */}
      <h1><Icon name={ICON[policy.slug] ?? "policy"} class="page-icon" /> {policy.title}</h1>
      {/*
        The same `set:html` the article page carries, with the same justification: the
        argument comes from `renderMarkdown`, which drops raw HTML rather than escaping it
        and sanitises what remains against the §57.1.3 schema.
      */}
      <div set:html={rendered.html} />
    </article>

    {/*
      §48, applied to the documents that say what may be done with the rest.
      These are read by models more than by people, and an agent deciding whether it may use
      this corpus should be able to fetch the licence as text rather than parse it out of a
      rendered page.
    */}
    <p class="machine-readable">
      Machine-readable, no API key required: <a href={`/${policy.slug}.md`} rel="alternate" type="text/markdown">markdown</a>
    </p>
  </main>
</Layout>
