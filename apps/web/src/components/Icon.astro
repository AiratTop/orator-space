---
/**
 * The interface's icon set, in one place (SPEC §49.5, §57.2).
 *
 * **Drawn, not fetched.** `img-src 'self'` would admit a file, but an icon inside a link has
 * to take that link's colour in both themes and in every state, and a fetched image cannot.
 *
 * **One file, because the same mark appears twice.** `Search` is in the masthead and at the
 * head of `/search`; the same is true of six others. Inline in both places they would be two
 * copies of a path that eventually differ by a curve nobody notices, so the set lives here
 * and both callers name it.
 *
 * **Shapes rather than a string of markup.** A record of SVG source per name would need
 * `set:html`, and the one `set:html` on this site is the sanitised article body — a second
 * one, even over a constant, is a second place somebody could put a variable. These are data
 * that this component turns into elements.
 *
 * Every icon is `aria-hidden`. Each is used beside its own word, and a screen reader
 * announcing "image, magnifier, Search" is told the same thing twice, once badly. A caller
 * with no visible word beside it gives the *link* an `aria-label`, which is the accessible
 * name of the thing being activated rather than of its decoration.
 */
type Shape = { d: string } | { circle: [cx: number, cy: number, r: number] };

const ICONS: Record<string, Shape[]> = {
  search: [{ circle: [11, 11, 6.5] }, { d: "m20 20-4.4-4.4" }],
  topics: [{ d: "M12 3.5 3.5 8l8.5 4.5L20.5 8 12 3.5Z" }, { d: "m3.5 12.5 8.5 4.5 8.5-4.5" }],
  docs: [
    { d: "M12 6.8S10.3 5 6.5 5H4v13h2.5c3.8 0 5.5 1.8 5.5 1.8V6.8Z" },
    { d: "M12 6.8S13.7 5 17.5 5H20v13h-2.5c-3.8 0-5.5 1.8-5.5 1.8V6.8Z" },
  ],
  bookmarks: [{ d: "M6.5 4.5h11v15l-5.5-4-5.5 4v-15Z" }],
  moderation: [{ d: "M6 20V4.5h9.5l-1.6 3 1.6 3H6" }],
  person: [{ circle: [12, 8.5, 3.5] }, { d: "M5 19.5a7 7 0 0 1 14 0" }],
  /*
   * A feed, in the shape everything else uses for one: a dot and two arcs.
   *
   * The dot is a stroked circle rather than a filled one, because every shape in this set is
   * stroked and a single filled mark in it would be the one icon that ignores the weight the
   * others share. At 1.05 it reads as a dot anyway.
   */
  feed: [
    { circle: [6.2, 17.8, 1.05] },
    { d: "M4.5 11.2a8.3 8.3 0 0 1 8.3 8.3" },
    { d: "M4.5 5.5a14 14 0 0 1 14 14" },
  ],
  settings: [
    { d: "M4 7.5h8M17 7.5h3M4 16.5h3M12 16.5h8" },
    { circle: [14.5, 7.5, 2.2] },
    { circle: [9.5, 16.5, 2.2] },
  ],
  /* A report is a warning about something, not a verdict on it — a triangle, not a flag. */
  report: [{ d: "M12 4.2 2.8 20h18.4L12 4.2Z" }, { d: "M12 10.5v4M12 17.4v.01" }],
  terms: [
    { d: "M6 3.5h8.5L19 8v12.5H6V3.5Z" },
    { d: "M14 3.5V8h5" },
    { d: "M9 12.5h6M9 16h4" },
  ],
  /* Nothing at that address: a magnifier with a line through it rather than a cross. */
  missing: [
    { circle: [11, 11, 6.5] },
    { d: "m20 20-4.4-4.4" },
    { d: "m8.6 8.6 4.8 4.8M13.4 8.6l-4.8 4.8" },
  ],
  privacy: [{ d: "M6 10.5h12v9H6v-9Z" }, { d: "M8.6 10.5V8a3.4 3.4 0 0 1 6.8 0v2.5" }],
  /*
   * The nine sections of the vocabulary (§22.1), one mark each.
   *
   * Each is a thing the section is *about* rather than a letter or an abstraction: a chart
   * for economics, a flask for research, a database for infrastructure. A reader should be
   * able to guess three of them without reading the labels, which is the whole of what an
   * icon in a list of nine headings can do.
   */
  "topic-ai": [
    { circle: [12, 5.5, 2.2] },
    { circle: [5.5, 17, 2.2] },
    { circle: [18.5, 17, 2.2] },
    { d: "M10.4 7.3 7.1 15.2M13.6 7.3l3.3 7.9M7.7 17h8.6" },
  ],
  "topic-business": [{ d: "M3.5 20h17" }, { d: "m5 15.5 4.5-5 3.5 3 6-6.5" }, { d: "M15 7h4v4" }],
  "topic-culture": [
    { d: "M3.5 8.5 12 4l8.5 4.5" },
    { d: "M5.5 8.5v9M10 8.5v9M14 8.5v9M18.5 8.5v9" },
    { d: "M3.5 20h17" },
  ],
  "topic-engineering": [{ d: "m8 8-4.5 4L8 16" }, { d: "m16 8 4.5 4L16 16" }, { d: "m13.4 5.5-2.8 13" }],
  "topic-health": [{ d: "M3 12h4l2-5 3.5 10 2.5-6.5 1.5 1.5H21" }],
  "topic-infrastructure": [
    { d: "M5 6.5c0-1.5 3.1-2.8 7-2.8s7 1.3 7 2.8-3.1 2.8-7 2.8-7-1.3-7-2.8Z" },
    { d: "M5 6.5v11c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8v-11" },
    { d: "M5 12c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8" },
  ],
  "topic-science": [
    { d: "M9.5 3.5h5" },
    { d: "M10.5 3.5v6L5.2 18a1.8 1.8 0 0 0 1.6 2.7h10.4a1.8 1.8 0 0 0 1.6-2.7L13.5 9.5v-6" },
    { d: "M8 14.8h8" },
  ],
  "topic-security": [
    { d: "M12 3 5 6v5.5c0 4 3 7.6 7 9.5 4-1.9 7-5.5 7-9.5V6l-7-3Z" },
    { circle: [12, 11, 1.6] },
    { d: "M12 12.6v2.4" },
  ],
  "topic-society": [
    { circle: [9, 8.5, 3] },
    { d: "M3.5 19.5a5.5 5.5 0 0 1 11 0" },
    { d: "M16 6.2a3 3 0 0 1 0 5.6" },
    { d: "M17.5 14.6a5.5 5.5 0 0 1 3 4.9" },
  ],
  policy: [
    { d: "M5.5 4.5h9L18.5 8v11.5h-13V4.5Z" },
    { d: "M14 4.5V8h4.5" },
    { d: "m8.8 13.6 1.7 1.7 3.4-3.4" },
  ],
};

interface Props {
  name: keyof typeof ICONS | string;
  /** Extra classes. `icon` is always applied, so a caller sizes rather than restates. */
  class?: string;
}

const { name, class: extra } = Astro.props;
const shapes = ICONS[name];
if (shapes === undefined) throw new Error(`no icon called "${name}"`);
---

<svg class={extra ? `icon ${extra}` : "icon"} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {shapes.map((shape) =>
    "circle" in shape ? (
      <circle cx={shape.circle[0]} cy={shape.circle[1]} r={shape.circle[2]} />
    ) : (
      <path d={shape.d} />
    ),
  )}
</svg>
