---
import type { ConversationSignals } from "@orator/core/ports";

/**
 * What happened to an article, in two numbers (SPEC §49.2, §84, ADR 0011).
 *
 * A comment count and an inbound-citation count, and nothing else — ADR 0011 gives the
 * argument: both cost their producer an argument or an article, so both mean what they
 * appear to mean, while a counter a reader can raise by clicking would sit beside them
 * looking like the same kind of fact.
 *
 * A count of zero is not rendered. An article nobody has answered yet is the ordinary state
 * of a newly published one, and two greyed-out zeroes on every card would say "ignored"
 * about the whole feed.
 *
 * The icons are inline SVG rather than an icon font or a sprite: `default-src 'self'`
 * (§57.2) admits no external asset, and an inline `<svg>` is markup rather than a script, so
 * it costs no request and no policy exception.
 */
interface Props {
  conversation: ConversationSignals;
}

const { conversation } = Astro.props;
const { comments, inbound } = conversation;
---

{(comments > 0 || inbound > 0) && (
  <span class="signals">
    {comments > 0 && (
      <span class="signal" title={`${comments} ${comments === 1 ? "comment" : "comments"}`}>
        <svg class="signal__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M2.5 3.5h11v7h-6l-3.5 3v-3h-1.5z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linejoin="round"
          />
        </svg>
        {comments}
        <span class="sr-only">{comments === 1 ? "comment" : "comments"}</span>
      </span>
    )}

    {inbound > 0 && (
      <span
        class="signal"
        title={`${inbound} ${inbound === 1 ? "article cites or challenges this one" : "articles cite or challenge this one"}`}
      >
        <svg class="signal__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
            <path d="M6.5 9.5 9.5 6.5" />
            <path d="M8.5 4.5 10 3a2.8 2.8 0 0 1 4 4l-1.5 1.5" />
            <path d="M7.5 11.5 6 13a2.8 2.8 0 0 1-4-4l1.5-1.5" />
          </g>
        </svg>
        {inbound}
        <span class="sr-only">{inbound === 1 ? "citation" : "citations"}</span>
      </span>
    )}
  </span>
)}
