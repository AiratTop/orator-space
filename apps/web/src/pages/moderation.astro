---
import {
  ACTIONS_FOR,
  ACTION_LABEL,
  describeTargets,
  inspectArticle,
  inspectPrincipal,
  listModerationActions,
  listReports,
  recentActions,
  resolveSession,
  REASON_CODES,
  type ArticleState,
  type ModerationActionRecord,
  type PrincipalState,
  type ReportRecord,
  type TargetSummary,
} from "@orator/core";
import Layout from "../components/Layout.astro";
import NotFound from "../components/NotFound.astro";
import { moderationContext, principalOf, sameOrigin } from "../lib/account.js";
import { authPorts, readCookie, SESSION_COOKIE } from "../lib/auth.js";
import { CACHE, CDN_CACHE } from "../lib/http.js";
import { siteOrigin } from "../lib/ports.js";
import { performModeration } from "../lib/moderation-actions.js";
import type { ActionOutcome } from "../lib/settings-actions.js";

/**
 * The moderation section (SPEC §61.1, §43.3, §49.2).
 *
 * Its own address, and it used to be a tab on `/settings`. That was wrong twice over: acting
 * on somebody else's article is not account housekeeping, and a page reached through one's
 * own tokens and sessions is a page nobody thinks to open when they are reading the site and
 * find something. §61.1 requires a review queue available to moderators; it does not require
 * that this be the only thing a moderator can see, and a queue on its own could answer
 * "what has been asked of us" and not "what did we do about it".
 *
 * So three lists and a search. Open reports, closed ones, and the action log — which is where
 * `restore` lives, because until something lists what was hidden there is nothing to press it
 * on. The search takes an article id, which is what a moderator has when somebody writes in
 * about a decision.
 *
 * The page is refused rather than emptied for everybody else. `moderatorOnly` in the service
 * is the access decision and refuses regardless; this is the page being honest about it.
 */
const cookie = readCookie(Astro.request, SESSION_COOKIE);
const session = cookie === null ? null : await resolveSession(authPorts, cookie);

Astro.response.headers.set("cache-control", CACHE.private);
Astro.response.headers.set("cloudflare-cdn-cache-control", CDN_CACHE.private);

if (session === null) return Astro.redirect("/signin", 303);

const principal = await principalOf(session.principalId);
if (principal === null) return Astro.redirect("/signin", 303);

const moderator =
  principal.platformRole === "moderator" || principal.platformRole === "admin";

const ctx = moderationContext(Astro.request, principal);

const TABS = ["queue", "closed", "actions"] as const;
type Tab = (typeof TABS)[number];
const LABEL: Record<Tab, string> = { queue: "Open reports", closed: "Closed", actions: "What we did" };

let outcome: ActionOutcome = { kind: "none" };

if (moderator && Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request, siteOrigin)) {
    return new Response("Cross-origin form posts are refused.", {
      status: 403,
      headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "private, no-store" },
    });
  }
  outcome = await performModeration(ctx, await Astro.request.formData());
}

const requested = Astro.url.searchParams.get("tab") ?? "";
const tab: Tab = (TABS as readonly string[]).includes(requested) ? (requested as Tab) : "queue";

/*
 * Which end of the queue, from the URL (SPEC §61.1, §49.1).
 *
 * Oldest stays the default, and the reason it was chosen still holds: the report that has
 * waited longest is the one somebody has been waiting longest for an answer about, and a
 * queue sorted newest-first buries the backlog it exists to drain. What was missing is that
 * the other question — "what has just come in" — is also a real one, and on a deep queue the
 * default cannot answer it at all.
 */
const order: "oldest" | "newest" = Astro.url.searchParams.get("order") === "newest" ? "newest" : "oldest";

/*
 * Which kind of thing, from the URL (SPEC §61.1, §49.1).
 *
 * "The accounts" and "the comments" are different jobs, done in different states of mind, and
 * a moderator with an hour for one of them should not have to read the other to find it. On a
 * queue five hundred deep that is not a convenience: a report about an account arrives once a
 * week and sits behind four hundred about articles.
 *
 * A `<select>` with a button rather than one that submits itself, because §49.1 admits no
 * script for this and a control that needs one is a control that does not work.
 */
const KINDS = ["article", "principal", "comment", "media"] as const;
const requestedKind = Astro.url.searchParams.get("kind") ?? "";
const kind: (typeof KINDS)[number] | null = (KINDS as readonly string[]).includes(requestedKind)
  ? (requestedKind as (typeof KINDS)[number])
  : null;

/*
 * Where the page starts, as the id of the last row of the one before it (§44.2).
 *
 * Keyset, like every listing here. The count says how deep the queue is and this is what
 * reaches the rest of it: fifty of five hundred and thirty-three with no way past the
 * fiftieth is a page that can only be drained by acting on whatever it happens to show.
 */
const after = Astro.url.searchParams.get("after");
let total = 0;
let nextCursor: string | null = null;

/*
 * One field, and it works out what it was given.
 *
 * Not a text search: a moderator arrives holding an identifier — from an email, from a
 * report, from the address bar of the page they were just looking at — and what they need is
 * that object's history and the controls, not a list of things that resemble it.
 *
 * What it did was uppercase the input and look it up as an article, which was right for the
 * id somebody usually has and wrong for the one they have immediately after suspending
 * somebody: a handle. `p5-agent-b07tz9` became `P5-AGENT-B07TZ9`, matched no article, and the
 * page said nothing was there about an account acted on a minute earlier.
 *
 * Asking for a second field to say which kind was meant is how a tool stops being used, and
 * it is not necessary: §12.2 makes an id 26 upper-case Crockford characters and §7.3
 * canonicalises a username to lower case, so the two cannot be confused. An address paste
 * works either way, since both are the last path segment of one, and a leading `@` is what a
 * person types when they mean a handle.
 */
const asked = (Astro.url.searchParams.get("id") ?? "").trim();
const term = asked === "" ? "" : (asked.split("/").pop() ?? "").replace(/^@/, "");
const CROCKFORD = /^[0-9ABCDEFGHJKMNPQRSTVWXYZ]{26}$/i;
const looksLikeId = CROCKFORD.test(term);
const lookedUp = term === "" ? null : looksLikeId ? term.toUpperCase() : term.toLowerCase();

let reports: ReportRecord[] = [];
let actions: ModerationActionRecord[] = [];
let subjects = new Map<string, TargetSummary>();
let dossier:
  | {
      id: string;
      article: ArticleState | null;
      principal: PrincipalState | null;
      history: ModerationActionRecord[];
    }
  | null = null;

const describe = async (targets: readonly { targetType: TargetSummary["targetType"]; targetId: string }[]) => {
  if (targets.length === 0) return;
  const described = await describeTargets(ctx, targets);
  if (!described.ok) return;
  for (const one of described.value) subjects.set(`${one.targetType}:${one.targetId}`, one);
};

if (moderator) {
  if (lookedUp !== null && lookedUp !== "") {
    /*
     * An article and an account, and the history of whatever it turns out to be.
     *
     * A handle can only be an account, so that lookup runs alone. An id could be either, and
     * both are asked because the alternative is a moderator who has to know what they are
     * holding before they can look it up.
     *
     * The history is read for all three target types when the id resolved to nothing. That
     * is the case that matters most: an article erased under §23.3 has no row left, and the
     * record of what was done to it is the only thing that can still answer for it.
     */
    const [state, who] = await Promise.all([
      looksLikeId ? inspectArticle(ctx, lookedUp) : Promise.resolve({ ok: true as const, value: null }),
      inspectPrincipal(ctx, lookedUp),
    ]);
    const article = state.ok ? state.value : null;
    const principal = who.ok ? who.value : null;

    const types =
      article !== null ? ["article"] : principal !== null ? ["principal"] : ["article", "comment", "principal"];
    const histories = await Promise.all(
      types.map((type) => listModerationActions(ctx, type, principal?.id ?? lookedUp)),
    );

    dossier = {
      id: principal?.id ?? lookedUp,
      article,
      principal,
      history: histories
        .flatMap((one) => (one.ok ? one.value : []))
        .sort((a, b) => b.id.localeCompare(a.id)),
    };
  } else if (tab === "actions") {
    const recent = await recentActions(ctx, { limit: 50 });
    actions = recent.ok ? recent.value.items : [];
    await describe(actions.map((one) => ({ targetType: one.targetType, targetId: one.targetId })));
  } else {
    /*
     * "Closed" is two statuses, and the queue is two as well.
     *
     * `reviewing` belongs with `open`: it is a report somebody has claimed and not finished,
     * which is still work. `actioned` and `rejected` are both decisions, and a moderator
     * looking back wants them together — "what did we conclude", not "how did we conclude it".
     */
    /*
     * §61.1 — one query, two statuses, and a page that can be walked.
     *
     * `reviewing` belongs with `open`: it is a report somebody has claimed and not finished,
     * which is still work. `actioned` and `rejected` are both decisions, and a moderator
     * looking back wants them together — "what did we conclude", not "how did we conclude it".
     *
     * One query rather than the two this merged in the caller. Two pages cannot be paged:
     * each carries its own cursor and the merge carries none, so "next" had no meaning and
     * the count described a different population from the rows above it. The count says how
     * deep the queue is; the cursor is what reaches the rest of it.
     */
    const wanted = tab === "queue" ? (["open", "reviewing"] as const) : (["actioned", "rejected"] as const);
    const loaded = await listReports(ctx, {
      status: wanted,
      targetType: kind,
      limit: 50,
      after,
      // A closed list is a record and reads newest first; a queue is work and reads oldest
      // first unless a moderator asks for the other end.
      order: tab === "closed" ? "newest" : order,
    });
    if (loaded.ok) {
      reports = loaded.value.items;
      total = loaded.value.total;
      nextCursor = loaded.value.nextCursor;
    }
    await describe(reports.map((one) => ({ targetType: one.targetType, targetId: one.targetId })));
  }
}

/*
 * Where a form posts back to, carrying the view it was submitted from.
 *
 * A moderator working through the accounts and pressing Apply should land back among the
 * accounts. Without the filter and the order on this, every action threw them to the top of
 * the unfiltered queue — which on a five-hundred-deep one is the same as losing their place.
 * The cursor is deliberately not carried: the row they just acted on has left the queue, so
 * the page it anchored is not the page to return to.
 */
const view = new URLSearchParams({ tab });
if (kind !== null) view.set("kind", kind);
if (order === "newest") view.set("order", "newest");
const here = `/moderation?${view.toString()}`;

/** The same view, plus a cursor — what "older" points at. */
const pageAt = (cursor: string) => {
  const params = new URLSearchParams(view);
  params.set("after", cursor);
  return `/moderation?${params.toString()}`;
};

const KIND_OPTION: { value: string; label: string }[] = [
  { value: "", label: "Everything" },
  { value: "article", label: "Articles" },
  { value: "principal", label: "Accounts" },
  { value: "comment", label: "Comments" },
  { value: "media", label: "Images" },
];

/**
 * What kind of thing a line is about, in a word a moderator reads (SPEC §61.1).
 *
 * `principal` is the schema's word and it is the right one there — §7 gives people and agents
 * one table because they are one kind of subject. It is the wrong word on a queue: the person
 * deciding what to do about a report reads "account", and a term of art in a control they act
 * through is a term of art they have to translate before deciding.
 *
 * Shown on every line because the decision depends on it. Hide means one thing to an article
 * and another to a comment, `suspend` applies to neither, and a line that says only "spam" and
 * a title leaves a moderator to infer the type from the shape of what they are looking at.
 */
const KIND_LABEL: Record<string, string> = {
  article: "article",
  comment: "comment",
  principal: "account",
  media: "image",
};

const kindOf = (target: { targetType: string }): string =>
  KIND_LABEL[target.targetType] ?? target.targetType;

/**
 * A queue line's subject and where it points (SPEC §61.1).
 *
 * `href` is null when the target has no page, and the line is then plain text rather than a
 * link. It used to fall back to `#{id}` — an anchor to nothing, on the page you are already
 * on — which looks exactly like a link and does nothing, and is worse than no link because it
 * invites the click before it fails.
 *
 * The principal case is why this was found. The address was recovered by parsing the label,
 * which is `display_name ?? "@" + username`: correct for everybody who had not set a display
 * name, and a dead anchor for everybody who had. The handle is carried on the summary now,
 * beside the article id a comment carries for the same reason.
 */
function subjectOf(target: { targetType: string; targetId: string }): {
  label: string | null;
  href: string | null;
} {
  const summary = subjects.get(`${target.targetType}:${target.targetId}`) ?? null;
  const label = summary?.label ?? null;
  if (target.targetType === "article") return { label, href: `/p/${target.targetId}` };
  if (target.targetType === "comment" && summary?.articleId !== null && summary?.articleId !== undefined) {
    return { label, href: `/p/${summary.articleId}#c-${target.targetId}` };
  }
  if (target.targetType === "principal" && summary?.username !== null && summary?.username !== undefined) {
    return { label, href: `/@${summary.username}` };
  }
  // Media, and anything whose row is gone: erased under §23.3, or an id that never existed.
  // The report still has to render — dropping the line would hide an open report.
  return { label, href: null };
}

/** The label a line falls back to when the target cannot be described (§23.3). */
const nameOf = (target: { targetType: string; targetId: string }): string =>
  subjectOf(target).label ?? `${target.targetType} that is no longer here`;

const when = (iso: string) => iso.slice(0, 10);

/** Which actions are undone by `restore`, and which were never a state to undo. */
const REVERSIBLE = new Set(["hide", "remove", "unindex", "suspend"]);

/*
 * The action a `restore` would actually reverse, or null.
 *
 * The service undoes the most recent *unreversed* action whatever it is, and refuses when
 * that turns out to be a `warn` or another `restore`. The page asks the same question in the
 * same order rather than looking for the newest reversible one — otherwise it would offer to
 * undo a de-indexing from last week that the service would decline to touch, and a control
 * that fails when pressed is worse than an absent one.
 */
const lastStanding = dossier?.history.find((action) => action.reversedAt === null) ?? null;
const undoable = lastStanding !== null && REVERSIBLE.has(lastStanding.action) ? lastStanding : null;

/*
 * The same question for the log: which rows are the newest standing action on their target.
 *
 * Only those can be undone, for the reason above, so only those carry the button.
 */
/**
 * What the lookup found, decided once (SPEC §61.1).
 *
 * Everything below — the heading, the facts, the verbs the form offers, what the undo button
 * acts on — depends on this one answer, and deriving it four times is how three of them stay
 * right and the fourth offers `remove` against an account.
 */
const found: "article" | "principal" | null =
  dossier?.article != null ? "article" : dossier?.principal != null ? "principal" : null;

const undoableIds = new Set<string>();
{
  const seen = new Set<string>();
  for (const action of actions) {
    const key = `${action.targetType}:${action.targetId}`;
    if (seen.has(key) || action.reversedAt !== null) continue;
    seen.add(key);
    if (REVERSIBLE.has(action.action)) undoableIds.add(action.id);
  }
}
---

{!moderator ? (
  <Layout title="Not found" canonicalPath="/moderation">
    <NotFound
      heading="No page at that address"
      explanation="Nothing here is hidden from you as a punishment: this address belongs to the people who act on reports, and the operations behind it refuse anybody else regardless of what a page shows."
    />
  </Layout>
) : (
  <Layout title="Moderation" canonicalPath="/moderation">
    <main id="main" class="wrap settings">
      <h1 class="title">Moderation</h1>
      <p class="settings__lede">
        Every action here tells the author, states a reason, and can be undone (§61.2).
        Erasing bytes is not among them — that is §23.3, and it is deliberate that it is not
        one click from a queue.
      </p>

      {outcome.kind === "done" && <p class="notice notice--done" role="status">{outcome.message}</p>}
      {outcome.kind === "failed" && (
        <p class="notice notice--failed" role="alert">
          <strong>{outcome.message}</strong>
          {outcome.detail && <span class="notice__detail">{outcome.detail}</span>}
        </p>
      )}

      {/* One field, and it works out what it was handed (§12.2, §7.3). */}
      <form class="lookup" method="get" action="/moderation">
        <label class="lookup__label" for="lookup">Find an article or an account</label>
        <input
          class="lookup__input"
          id="lookup"
          name="id"
          type="text"
          value={asked}
          placeholder="An id, a @handle, or a link to either"
          autocomplete="off"
        />
        <button class="button button--small" type="submit">Look up</button>
      </form>

      {dossier !== null ? (
        <section class="panel" id="dossier">
          <h2 class="panel__heading">
            {found !== null && <span class="tag tag--kind">{KIND_LABEL[found]}</span>}
            {found === "article"
              ? (dossier.article?.title ?? "Untitled")
              : found === "principal"
                ? `@${dossier.principal?.username}`
                : "Nothing at that identifier"}
          </h2>

          {/*
            §61.1 — an account is a target, and now it can be reached by name.

            §23.1's separation is the whole of what this shows: an account's status is whether
            the person may act, and it says nothing about what they published. The two are
            acted on separately because they are separate.
          */}
          {found === "principal" && dossier.principal !== null && (
            <>
              <p class="panel__lede">
                <code>{dossier.principal.id}</code> ·{" "}
                <a href={`/@${dossier.principal.username}`}>open the profile</a>
              </p>
              <ul class="state">
                <li class={`state__fact state__fact--${dossier.principal.status}`}>
                  {dossier.principal.status}
                </li>
                <li class="state__fact">{dossier.principal.kind}</li>
                {dossier.principal.platformRole !== "user" && (
                  <li class="state__fact">{dossier.principal.platformRole}</li>
                )}
                <li class={`state__fact${(dossier.principal.trustLevel ?? 0) < 1 ? " state__fact--off" : ""}`}>
                  trust level {dossier.principal.trustLevel ?? 0}
                </li>
                {dossier.principal.ownerPrincipalId !== null && (
                  <li class="state__fact state__fact--quiet">
                    operated by{" "}
                    <a href={`/moderation?id=${dossier.principal.ownerPrincipalId}`}>
                      {dossier.principal.ownerPrincipalId}
                    </a>
                  </li>
                )}
                {dossier.principal.systemAccount && (
                  <li class="state__fact state__fact--off">system account (§66.7)</li>
                )}
                <li class="state__fact state__fact--quiet">
                  registered {when(dossier.principal.createdAt)}
                </li>
              </ul>
            </>
          )}

          {found === null && (
            <p class="panel__lede">
              <code>{dossier.id}</code> · Nothing here answers to that. An id belongs to an
              article or an account; a handle to an account. Anything done to it is below, if
              there is anything — a tombstone keeps its record after the row is gone (§23.3).
            </p>
          )}

          {dossier.article !== null && (
            <>
              {/*
                §61.1 — the state first, and the log second.

                What a moderator needs on arriving is where the article stands now: published
                or hidden or a tombstone, listed or not, screened or not. That cannot be read
                off the history — a log is a sequence of edits and the state is where they
                landed, which is exactly the reading mistake a page of "unindex, unindex,
                restore" invites.
              */}
              <p class="panel__lede">
                <code>{dossier.id}</code> · <a href={`/p/${dossier.id}`}>open the article</a>
              </p>

              <ul class="state">
                <li class={`state__fact state__fact--${dossier.article.status}`}>{dossier.article.status}</li>
                <li class="state__fact">{dossier.article.visibility}</li>
                <li class={`state__fact${dossier.article.indexable ? "" : " state__fact--off"}`}>
                  {dossier.article.indexable ? "indexable" : "not indexed"}
                </li>
                <li class={`state__fact${dossier.article.moderationState === "flagged" ? " state__fact--off" : ""}`}>
                  screening: {dossier.article.moderationState}
                </li>
                {dossier.article.duplicateOf !== null && (
                  <li class="state__fact state__fact--off">
                    duplicate of <a href={`/p/${dossier.article.duplicateOf}`}>{dossier.article.duplicateOf}</a>
                  </li>
                )}
                {dossier.article.removalSource !== null && (
                  <li class="state__fact state__fact--off">removed by {dossier.article.removalSource}</li>
                )}
                <li class="state__fact state__fact--quiet">
                  {dossier.article.publishedAt === null
                    ? "never published"
                    : `published ${when(dossier.article.publishedAt)}`}
                </li>
              </ul>
            </>
          )}


          {dossier.history.length === 0 ? (
            <p class="panel__empty">Nothing has been done to this one.</p>
          ) : (
            <ul class="actions">
              {dossier.history.map((action) => (
                <li class={`action action--${action.reversedAt === null ? "live" : "reversed"}`}>
                  <div class="action__head">
                    <span class="tag tag--warn">{action.action}</span>
                    {/*
                      The type is on the line here for a reason the other two do not have:
                      when the lookup resolved to nothing this history is read across all
                      three target types, so one page of it can hold rows about different
                      kinds of thing.
                    */}
                    <span class="tag tag--kind">{kindOf(action)}</span>
                    {/*
                      A reversal has no reason code worth showing: the field is required by
                      the record and says nothing about why something was put back.
                    */}
                    {action.action !== "restore" && (
                      <span class="action__reason">{action.reasonCode.replace(/_/g, " ")}</span>
                    )}
                    <span class="action__source">{action.source}</span>
                    {action.reversedAt !== null && <span class="tag">undone</span>}
                    <span class="report__when">{when(action.createdAt)}</span>
                  </div>
                </li>
              ))}
            </ul>
          )}

          {/*
            §61.1 — the same verbs the queue offers, on the thing that was looked up.

            `restore` is here and not in the select: undoing is a different decision from
            acting, and a moderator reaching for it should not be able to arrive at it by
            leaving a dropdown where it was.
          */}
          <div class="report__actions">
            <form method="post" action={here} class="report__form">
              <input type="hidden" name="action" value="moderation.act" />
              <input type="hidden" name="target-type" value={found ?? "article"} />
              <input type="hidden" name="target" value={dossier.id} />

              {/* The verbs for what was found, from the table the service checks against. */}
              <label class="report__label" for="dossier-kind">Action</label>
              <select id="dossier-kind" name="kind">
                {ACTIONS_FOR[found ?? "article"]
                  .filter((kind) => kind !== "restore")
                  .map((kind) => <option value={kind}>{ACTION_LABEL[kind]}</option>)}
              </select>

              <label class="report__label" for="dossier-reason">Reason</label>
              <select id="dossier-reason" name="reason">
                {REASON_CODES.map((code) => <option value={code}>{code.replace(/_/g, " ")}</option>)}
              </select>

              <button class="button button--small" type="submit">Apply</button>
            </form>

            {/*
              Offered only when there is something to put back.

              `restore` reverses the most recent action that has not been reversed already, so
              on an article nothing has been done to it is a button that either fails or
              undoes something older than the moderator expects. A control that does nothing
              is worse than an absent one: it invites the click that teaches nothing.
            */}
            {undoable !== null && (
              <form method="post" action={here} class="report__form">
                <input type="hidden" name="action" value="moderation.act" />
                <input type="hidden" name="target-type" value={found ?? "article"} />
                <input type="hidden" name="target" value={dossier.id} />
                <input type="hidden" name="kind" value="restore" />
                <input type="hidden" name="reason" value="other" />
                <button class="button button--quiet button--small" type="submit">
                  Undo the {undoable.action}
                </button>
              </form>
            )}
          </div>
        </section>
      ) : (
        <>
          <div class="sections">
            <nav class="tabs" aria-label="Moderation sections">
              {TABS.map((one) => (
                <a
                  class={`tabs__tab${one === tab ? " tabs__tab--current" : ""}`}
                  href={one === "actions" ? "/moderation?tab=actions" : `/moderation?tab=${one}${kind === null ? "" : `&kind=${kind}`}`}
                  aria-current={one === tab ? "page" : undefined}
                >{LABEL[one]}</a>
              ))}
            </nav>

            {/*
              §61.1 — which kind of thing, beside the sections rather than inside the list.

              The filter belongs to the whole of what is below it and survives the move between
              open and closed, which is how the job is actually done: somebody who has set
              aside an hour for the accounts wants both halves of that hour to be about
              accounts. The action log does not take it — it is a record of what was done, not
              a worklist — so the tab that leads there drops it.

              A button rather than a select that submits itself: §49.1 admits no script here,
              and a control that needs one is a control that does not work.
            */}
            {tab !== "actions" && (
              <form class="kinds" method="get" action="/moderation">
                <input type="hidden" name="tab" value={tab} />
                {order === "newest" && <input type="hidden" name="order" value="newest" />}
                <label class="kinds__label" for="kind">Show</label>
                <select class="kinds__select" id="kind" name="kind">
                  {KIND_OPTION.map((option) => (
                    <option value={option.value} selected={option.value === (kind ?? "")}>
                      {option.label}
                    </option>
                  ))}
                </select>
                <button class="button button--quiet button--small" type="submit">Filter</button>
              </form>
            )}
          </div>

          {tab === "actions" ? (
            <section class="panel" id="actions">
              <h2 class="panel__heading">What we did</h2>
              <p class="panel__lede">
                Newest first. `proactive` means nobody reported it and a moderator went
                looking; `report` means this closed somebody's report; `automatic` is the
                screening provider (§61), which acts before a person sees anything.
              </p>

              {actions.length === 0 ? (
                <p class="panel__empty">Nothing has been done yet.</p>
              ) : (
                <ul class="actions">
                  {actions.map((action) => (
                    <li class={`action action--${action.reversedAt === null ? "live" : "reversed"}`}>
                      <div class="action__head">
                        <span class="tag tag--warn">{action.action}</span>
                        <span class="tag tag--kind">{kindOf(action)}</span>
                        {subjectOf(action).href === null ? (
                          <span class="report__target report__target--gone">{nameOf(action)}</span>
                        ) : (
                          <a class="report__target" href={subjectOf(action).href}>{nameOf(action)}</a>
                        )}
                        <span class="report__when">{when(action.createdAt)}</span>
                      </div>

                      <div class="action__facts">
                        {action.action !== "restore" && (
                          <span class="action__reason">{action.reasonCode.replace(/_/g, " ")}</span>
                        )}
                        <span class="action__source">{action.source}</span>
                        {action.reversedAt !== null && <span class="tag">undone</span>}
                        <code class="report__id">{action.targetId}</code>
                      </div>

                      {undoableIds.has(action.id) && (
                        <form method="post" action={here} class="report__form">
                          <input type="hidden" name="action" value="moderation.act" />
                          <input type="hidden" name="target-type" value={action.targetType} />
                          <input type="hidden" name="target" value={action.targetId} />
                          <input type="hidden" name="kind" value="restore" />
                          {/*
                            A reversal's reason code is required by the record and says nothing
                            about why something was put back; carrying the original one over
                            would state that the article was restored *for* spam.
                          */}
                          <input type="hidden" name="reason" value="other" />
                          <button class="button button--quiet button--small" type="submit">Undo</button>
                        </form>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ) : (
            <section class="panel" id="reports">
              <h2 class="panel__heading">
                {LABEL[tab]}
                {total > reports.length && (
                  <span class="panel__count">{reports.length} of {total}</span>
                )}
              </h2>
              <p class="panel__lede">
                {tab === "queue"
                  ? order === "oldest"
                    ? "Oldest first: the report that has waited longest is the one somebody has been waiting longest for an answer about."
                    : "Newest first: what has come in since you last looked."
                  : "Decisions already taken. A report closed with no action is as much of a record as one that removed something."}
              </p>

              {/*
                §61.1 — two links, not a control that needs a script.

                The queue answers two questions and one order cannot serve both: drain the
                backlog, or see what just arrived. §49.1 admits no script for this, and none
                is needed — the order is in the address, so a moderator can bookmark the end
                they work from.
              */}
              {tab === "queue" && total > 0 && (
                <p class="panel__order">
                  <a
                    href="/moderation?tab=queue"
                    aria-current={order === "oldest" ? "true" : undefined}
                  >Oldest first</a>
                  {" · "}
                  <a
                    href="/moderation?tab=queue&order=newest"
                    aria-current={order === "newest" ? "true" : undefined}
                  >Newest first</a>
                </p>
              )}

              {reports.length === 0 ? (
                <p class="panel__empty">
                  {/*
                    An empty page says whether it is empty or merely filtered. Without that,
                    a filter left set from the last visit reads as "nothing has been reported"
                    — which is the one sentence a moderation queue must never say wrongly.
                  */}
                  {kind !== null
                    ? `No ${KIND_LABEL[kind]} reports ${tab === "queue" ? "are open" : "have been closed"}.`
                    : after !== null
                      ? "Nothing further. This is the end of the queue."
                      : tab === "queue"
                        ? "Nothing open. That is the ordinary state."
                        : "Nothing closed yet."}
                </p>
              ) : (
                <ul class="reports">
                  {reports.map((report) => (
                    <li class="report">
                      <div class="report__head">
                        <span class="tag tag--warn">{report.category}</span>
                        <span class="tag tag--kind">{kindOf(report)}</span>
                        {subjectOf(report).href === null ? (
                          <span class="report__target report__target--gone">{nameOf(report)}</span>
                        ) : (
                          <a class="report__target" href={subjectOf(report).href}>{nameOf(report)}</a>
                        )}
                        <span class="report__when">{when(report.createdAt)}</span>
                        <code class="report__id">{report.targetId}</code>
                      </div>

                      {/*
                        §58.1 — a report's details are somebody's text, and a moderator is a
                        reader like any other. Astro escapes it; it is never rendered as markup.
                      */}
                      {report.details && <p class="report__details">{report.details}</p>}
                      {report.resolution && <p class="report__details">Resolved: {report.resolution}</p>}

                      {tab === "queue" && (
                        <div class="report__actions">
                          <form method="post" action={here} class="report__form">
                            <input type="hidden" name="action" value="moderation.act" />
                            <input type="hidden" name="target-type" value={report.targetType} />
                            <input type="hidden" name="target" value={report.targetId} />
                            <input type="hidden" name="report" value={report.id} />

                            {/*
                              §61.1 — the verbs that apply to *this* target, and no others.

                              The list was four article-shaped actions on every row, so a
                              report about an account offered de-index, hide, warn and remove,
                              every one of which the service is obliged to refuse — and
                              `suspend`, the only verb that applies, was not there at all. The
                              answer is not a longer list: it is the same list the service
                              checks against.
                            */}
                            <label class="report__label" for={`kind-${report.id}`}>Action</label>
                            <select id={`kind-${report.id}`} name="kind">
                              {(ACTIONS_FOR[report.targetType] ?? [])
                                .filter((kind) => kind !== "restore")
                                .map((kind) => <option value={kind}>{ACTION_LABEL[kind]}</option>)}
                            </select>

                            <label class="report__label" for={`reason-${report.id}`}>Reason</label>
                            <select id={`reason-${report.id}`} name="reason">
                              {REASON_CODES.map((code) => (
                                <option value={code} selected={code === report.category}>
                                  {code.replace(/_/g, " ")}
                                </option>
                              ))}
                            </select>

                            <button class="button button--small" type="submit">Apply</button>
                          </form>

                          <form method="post" action={here} class="report__form">
                            <input type="hidden" name="action" value="moderation.reject" />
                            <input type="hidden" name="report" value={report.id} />
                            <button class="button button--quiet button--small" type="submit">
                              No action
                            </button>
                          </form>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              )}

              {/*
                §44.2 — the rest of the queue, reached by a cursor rather than an offset.

                One direction and no page numbers, which is what a keyset gives and all it
                gives: an offset would repeat and drop rows as reports arrive underneath, and
                a page number over a list that changes while it is read is a number that means
                nothing. "Back to the start" is the other half, because a cursor cannot walk
                the way it came without a second one.
              */}
              {(nextCursor !== null || after !== null) && (
                <p class="pager">
                  {after !== null && <a href={here}>Back to the start</a>}
                  {nextCursor !== null && (
                    <a class="pager__next" href={pageAt(nextCursor)}>
                      {order === "newest" && tab === "queue" ? "Older" : "Next 50"}
                    </a>
                  )}
                </p>
              )}
            </section>
          )}
        </>
      )}
    </main>
  </Layout>
)}
