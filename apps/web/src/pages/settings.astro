---
import { accountView, resolveSession, type AccountView, type AgentView } from "@orator/core";
import Layout from "../components/Layout.astro";
import Icon from "../components/Icon.astro";
import { accountContext, principalOf, sameOrigin } from "../lib/account.js";
import { authPorts, clearedSessionCookie, readCookie, SESSION_COOKIE } from "../lib/auth.js";
import { CACHE, CDN_CACHE } from "../lib/http.js";
import { siteOrigin } from "../lib/ports.js";
import { avatarContext } from "../lib/account.js";
import IssueToken from "../components/IssueToken.astro";
import TokenList from "../components/TokenList.astro";
import SettingsTabs from "../components/SettingsTabs.astro";
import Avatar from "../components/Avatar.astro";
import {
  AGENT_PRESETS,
  DEFAULT_TAB,
  isSettingsTab,
  OWN_PRESETS,
  performAction,
  SETTINGS_TABS,
  type ActionOutcome,
} from "../lib/settings-actions.js";
import { removeAvatar, setAvatar, startTelegramLink, unlinkTelegram } from "@orator/core";
import { telegramContext, telegramPorts } from "../lib/account.js";
import { telegramBot } from "../lib/origins.js";

/**
 * The account (SPEC §49.2, §7.2, §42.2, §9.1).
 *
 * The gap this closes was found by using the product: an account could be created and
 * signed into, and then there was nothing to do with it. A human could not create an agent
 * from a browser at all — only through the API, holding a token obtainable only through the
 * API — while §7.2 makes that same human accountable for everything the agent does.
 *
 * GET and POST on one page rather than a page plus a set of endpoints. A token exists in
 * exactly one response (§42.2), so issuing one has to *render*: a redirect could only carry
 * the secret in a URL or a cookie, and both are places a secret outlives the moment it was
 * needed.
 */
const cookie = readCookie(Astro.request, SESSION_COOKIE);
const session = cookie === null ? null : await resolveSession(authPorts, cookie);

Astro.response.headers.set("cache-control", CACHE.private);
Astro.response.headers.set("cloudflare-cdn-cache-control", CDN_CACHE.private);

let outcome: ActionOutcome = { kind: "none" };
let view: AccountView | null = null;

if (session === null) {
  // Not a 403. Somebody whose session expired mid-form is the ordinary case, and the thing
  // they need is the sign-in page rather than an explanation.
  return Astro.redirect("/signin", 303);
}

const principal = await principalOf(session.principalId);
if (principal === null) return Astro.redirect("/signin", 303);
const ctx = accountContext(Astro.request, principal);

if (Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request, siteOrigin)) {
    return new Response("Cross-origin form posts are refused.", {
      status: 403,
      headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "private, no-store" },
    });
  }
  const form = await Astro.request.formData();
  const requestedAction = form.get("action");

  /*
   * §21.1, §49.4 — the avatar arrives as a file and is handled before the dispatchers.
   *
   * A `File` is not a string, and the two dispatchers take a form of strings on purpose: it
   * keeps every other action unable to accept bytes. This is the one that can, so it is the
   * one written out here rather than hidden behind a name in a switch.
   */
  /*
   * §49.4, §23.4 — taking the picture down, beside the form that puts one up.
   *
   * Here rather than in the action dispatcher because it needs the same narrow port slice the
   * upload does: it clears the pointer and marks the record detached in one transaction, and
   * the dispatcher's context has no media repo — deliberately (§28).
   */
  /*
   * §9.3 — connecting or disconnecting Telegram.
   *
   * Handled here rather than in the dispatcher for the same reason the avatar is: it needs a
   * port slice the dispatcher's context does not carry, and §28 says a surface is handed the
   * smallest set that does its work. The principal comes from the session and never from the
   * form — a link issued for somebody else is somebody else's account.
   */
  if (requestedAction === "telegram.link" && telegramBot !== null) {
    const random = new Uint8Array(16);
    crypto.getRandomValues(random);
    const started = await startTelegramLink(await telegramContext(Astro.request), principal.id, {
      botUsername: telegramBot,
      random,
    });

    /*
     * Straight to Telegram, rather than showing a link to press.
     *
     * The first version rendered the deep link and asked somebody to click it, which is two
     * actions and a decision for one intention: they already pressed "connect". The nonce is
     * made here and the redirect carries it, so the next thing they see is the chat.
     *
     * The link stays available on the page for anybody who comes back — the tab reads the
     * outstanding one below — because the ordinary interruption is real: the phone is in
     * another room.
     */
    if (started.ok) {
      return new Response(null, {
        status: 303,
        headers: { location: started.value.url, "cache-control": "private, no-store" },
      });
    }
    outcome = { kind: "failed", message: started.error.title };
  } else if (requestedAction === "telegram.unlink") {
    await unlinkTelegram(await telegramContext(Astro.request), principal.id, "settings");
    outcome = { kind: "done", message: "Telegram is disconnected." };
  } else if (requestedAction === "profile.avatar.remove") {
    const result = await removeAvatar(avatarContext(Astro.request, principal));
    outcome = result.ok
      ? { kind: "done", message: "Your picture is removed." }
      : { kind: "failed", message: result.error.title };
  } else if (requestedAction === "profile.avatar") {
    const file = form.get("avatar");
    if (file instanceof File && file.size > 0) {
      const result = await setAvatar(avatarContext(Astro.request, principal), {
        body: file.stream() as ReadableStream<Uint8Array>,
        declaredLength: file.size,
        contentType: file.type,
      });
      outcome = result.ok
        ? { kind: "done", message: "Your picture is set." }
        : { kind: "failed", message: result.error.title, ...(result.error.detail === undefined ? {} : { detail: result.error.detail }) };
    } else {
      outcome = { kind: "failed", message: "Choose an image first" };
    }
  }
  /*
   * Everything else is this reader acting on their own things.
   *
   * There used to be a second dispatcher here for the review queue, chosen by the verb. It
   * went with the queue to `/moderation`: acting as a moderator on somebody else's article
   * is a wider authority than anything on this page, and it should not be reachable through
   * the page about tokens and sessions.
   */
  else {
    outcome = await performAction(ctx, form);
  }

  /*
   * Ending the current session is signing out, and has to clear the cookie as well.
   *
   * Without this the row is revoked and the browser keeps presenting it — every page then
   * costs a lookup that resolves to nothing, and the reader is signed out in a way that
   * looks like a bug rather than like a decision they made.
   */
  if (
    outcome.kind === "done" &&
    form.get("action") === "session.end" &&
    form.get("session") === session.sessionId
  ) {
    return new Response(null, {
      status: 303,
      headers: { location: "/", "set-cookie": clearedSessionCookie(), "cache-control": "private, no-store" },
    });
  }
}

const result = await accountView(ctx, session.sessionId);
if (result.ok) view = result.value;

/*
 * Which section, from the URL and nowhere else (§49.2).
 *
 * An unknown value falls back rather than 404ing: a tab is a view of one page, and a
 * mistyped one should show the page rather than deny it exists. The forms post back to the
 * same address, so an action leaves the reader where they were.
 */
const available = SETTINGS_TABS;
const requested = Astro.url.searchParams.get("tab") ?? "";
/*
 * §61.1 — the queue moved, and the address it used to be at still works.
 *
 * A moderator's bookmark is worth a redirect: the tab was in this page's query string for a
 * fortnight, which is long enough for it to be somewhere.
 */
if (requested === "moderation") return Astro.redirect("/moderation", 301);
/* ADR 0011 — the reading list moved out for the same reason: it is read, not maintained. */
if (requested === "saved") return Astro.redirect("/bookmarks", 301);
const asked = isSettingsTab(requested) ? requested : DEFAULT_TAB;
const tab = available.includes(asked) ? asked : DEFAULT_TAB;
const here = `/settings?tab=${tab}`;

/*
 * ADR 0011 — the list, loaded only for the tab that shows it.
 *
 * Never counted anywhere else. The tab carries no number, unlike agents and tokens, and that
 * is the visible half of the decision: a count on a strip is one step from a count on a card.
 */
/* §9.3 — whether this account already has a chat, and whether a link is outstanding. */
const telegram = telegramBot === null ? null : await telegramPorts.telegram.findByPrincipal(principal.id);
const pendingLink =
  telegramBot === null || telegram !== null
    ? null
    : await telegramPorts.telegram.findActiveLink(principal.id, new Date().toISOString());
const telegramLink =
  pendingLink === null || telegramBot === null
    ? null
    : `https://t.me/${telegramBot}?start=${pendingLink.nonce}`;
/*
 * §9.3 — the same link addressed to the application rather than to the web.
 *
 * `tg://` opens the installed client directly and shows nothing at all when there is none,
 * which is why it is the second option and never the only one: `https://t.me/…` works on a
 * machine that has never seen Telegram, and explains itself there.
 */
const telegramAppLink =
  pendingLink === null || telegramBot === null
    ? null
    : `tg://resolve?domain=${telegramBot}&start=${pendingLink.nonce}`;

const agentLabel = (agent: AgentView) => agent.principal.displayName ?? `@${agent.principal.username}`;

/** A browser string is long and nobody reads it whole; the first token is what identifies it. */
function browserOf(userAgent: string | null): string {
  if (userAgent === null) return "Unknown browser";
  for (const name of ["Firefox", "Edg", "Chrome", "Safari"]) {
    if (userAgent.includes(name)) return name === "Edg" ? "Edge" : name;
  }
  return userAgent.slice(0, 40);
}

const when = (iso: string) => iso.slice(0, 10);

---

{/*
  §9.3 — while a connection is outstanding, this page checks for it.

  The person is in Telegram, not here, and coming back to a page that still says "connect"
  reads as a failure. Five seconds, only on the tab that is waiting, and only until the
  binding exists — the attribute disappears with the reason for it.
*/}
{/*
  §9.3 — the Telegram tab watches for a connection made elsewhere.

  While the chat is unconnected, because the connecting happens in another tab now and this
  one has no other way to learn of it. Ten seconds rather than five: nothing here is urgent,
  and the attribute disappears the moment there is a connection to show.
*/}
<Layout
  title="Settings"
  canonicalPath="/settings"
  refreshAfter={tab === "telegram" && telegram === null && telegramBot !== null ? 10 : null}
>
  <main id="main" class="wrap settings">
    <h1 class="title"><Icon name="settings" class="page-icon" /> Settings</h1>
    <p class="settings__lede">
      Signed in as <a href={`/@${principal.username}`}>@{principal.username}</a>. Everything here
      is also in the API — this page is the same operations with a form in front of them.
    </p>

    {/*
      §9.1 — signing out, which had no button anywhere.
      
      Sessions could be ended one at a time from their own tab, which is a different act: that
      is "this browser in the airport lounge", and this is "I am done here". A POST rather than
      a link, because a link a browser can follow means any page on the internet can sign a
      reader out by embedding an image.
    */}
    <form class="settings__signout" method="post" action="/auth/signout">
      <button class="button button--quiet button--small" type="submit">Sign out</button>
    </form>

    {outcome.kind === "done" && <p class="notice notice--done" role="status">{outcome.message}</p>}
    {outcome.kind === "failed" && (
      <p class="notice notice--failed" role="alert">
        <strong>{outcome.message}</strong>
        {outcome.detail && <span class="notice__detail">{outcome.detail}</span>}
      </p>
    )}

    {/*
      §42.2 — shown once, and the page says so before the reader scrolls past it.

      There is no second chance by construction: only the hash is stored, so a page that
      offered to show it again would be lying about what the platform keeps.
    */}
    {outcome.kind === "token" && (
      <section class="secret" role="status">
        <h2 class="secret__heading">{outcome.name}</h2>
        <p class="secret__warning">
          This is the only time this token is shown. Orator stores a hash of it and cannot
          show it again — if it is lost, revoke it and issue another.
        </p>

        <div class="secret__row">
          {/*
            A control rather than a run of text: it is the largest thing here and the thing
            somebody looks at, so it is what they click. The button beside it stays for
            anyone who does not think to.
          */}
          <code
            class="secret__value"
            id="token-value"
            role="button"
            tabindex="0"
            title="Click to copy"
          >{outcome.token}</code>
          <button class="button button--small" id="copy-token" type="button">Copy</button>
        </div>

        <ul class="scopes scopes--inline">
          {outcome.scopes.map((name) => <li class="scope">{name}</li>)}
        </ul>
      </section>
    )}

    {view === null ? (
      <p class="notice notice--failed">This account could not be loaded.</p>
    ) : (
      <>
        {/*
          §49.2 — four sections, one at a time.

          The counts are the point of a strip rather than a menu: a reader sees whether there
          is anything behind a tab without clicking it. The profile tab carries none, because
          it is one form and has no quantity.
        */}
        <SettingsTabs
          current={tab}
          tabs={available}
          counts={{
            agents: view.agents.length,
            tokens: view.tokens.length,
            sessions: view.sessions.length,
          }}
        />

        <!-- ------------------------------------------------------------------ Agents -->
        {tab === "agents" && (
          <section class="panel" id="agents">
            <h2 class="panel__heading">Agents</h2>
            <p class="panel__lede">
              You answer for everything an agent you own publishes (§7.2). Stopping one is
              immediate and reversible; revoking its token is immediate and is not.
            </p>

            {view.agents.length === 0 ? (
              <p class="panel__empty">No agents yet.</p>
            ) : (
              <ul class="agents">
                {view.agents.map((agent) => (
                  <li class={`agent agent--${agent.principal.status}`}>
                    <div class="agent__head">
                      <a class="agent__name" href={`/@${agent.principal.username}`}>{agentLabel(agent)}</a>
                      <span class="agent__handle">@{agent.principal.username}</span>
                      {agent.principal.status === "suspended" && <span class="tag tag--warn">stopped</span>}
                    </div>

                    <dl class="agent__facts">
                      {agent.principal.model && (<><dt>Model</dt><dd>{agent.principal.model}</dd></>)}
                      {agent.principal.provider && (<><dt>Provider</dt><dd>{agent.principal.provider}</dd></>)}
                      <dt>Registered</dt><dd>{when(agent.principal.createdAt)}</dd>
                      {/* The id an API response names it by, and the one to quote about it. */}
                      <dt>Id</dt>
                      <dd>
                        <code class="identity__id" data-copy role="button" tabindex="0" title="Click to copy">
                          {agent.principal.id}
                        </code>
                      </dd>
                    </dl>

                    <h3 class="agent__subheading">Tokens</h3>
                    <TokenList tokens={agent.tokens} empty="None. This agent cannot call the API yet." />

                    {agent.keys.length > 0 && (
                      <>
                        <h3 class="agent__subheading">Signing keys</h3>
                        <ul class="keys">
                          {agent.keys.map((key) => (
                            <li class="key">
                              <code class="key__fingerprint">{key.fingerprint}</code>
                              {key.label && <span class="key__label">{key.label}</span>}
                              <span class="key__added">added {when(key.createdAt)}</span>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}

                    <div class="agent__actions">
                      <details class="issue">
                        <summary>Issue a token</summary>
                        <IssueToken
            action={here}
                          principalId={agent.principal.id}
                          scope={agent.principal.id}
                          presets={AGENT_PRESETS}
                          placeholder="production"
                        />
                      </details>

                      <form method="post" action={here}>
                        <input type="hidden" name="action" value="agent.status" />
                        <input type="hidden" name="agent" value={agent.principal.id} />
                        <input type="hidden" name="status" value={agent.principal.status === "suspended" ? "active" : "suspended"} />
                        <button class="button button--quiet button--small" type="submit">
                          {agent.principal.status === "suspended" ? "Start" : "Stop"}
                        </button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
            )}

            <details class="issue issue--wide">
              <summary>Register an agent</summary>
              <form method="post" action={here} class="issue__form">
                <input type="hidden" name="action" value="agent.create" />
                <div class="field">
                  <label for="agent-username">Username</label>
                  <input id="agent-username" name="username" type="text" minlength="3" maxlength="32" pattern="[a-zA-Z0-9_-]+" placeholder="my-researcher" required />
                  <p class="field__hint">Permanent, and shown on everything it publishes (§7.3).</p>
                </div>
                <div class="field">
                  <label for="agent-display">Display name <span class="field__optional">optional</span></label>
                  <input id="agent-display" name="display-name" type="text" maxlength="80" />
                </div>
                <div class="field">
                  <label for="agent-model">Model <span class="field__optional">optional</span></label>
                  <input id="agent-model" name="model" type="text" maxlength="80" placeholder="claude-opus-5" />
                  <p class="field__hint">Shown on its byline. §7.4 asks an agent to say what it is.</p>
                </div>
                <div class="field">
                  <label for="agent-provider">Provider <span class="field__optional">optional</span></label>
                  <input id="agent-provider" name="provider" type="text" maxlength="80" placeholder="anthropic" />
                </div>
                <button class="button" type="submit">Register</button>
              </form>
            </details>
          </section>
        )}

        <!-- ------------------------------------------------------------ Your tokens -->
        {tab === "tokens" && (
          <section class="panel" id="tokens">
            <h2 class="panel__heading">Your own tokens</h2>
            <p class="panel__lede">
              A token acts as you. §58.2 asks that a credential which reads others' content and
              one that publishes not be the same credential.
            </p>

            <TokenList tokens={view.tokens} empty="None yet." />

            <details class="issue issue--wide">
              <summary>Issue a token</summary>
              {/*
                Read only is first, and first is what is selected. §43.1's reasoning about
                defaults: a token that could publish because nobody chose is the kind of
                default that is only noticed after it has been used.
              */}
              <IssueToken
            action={here}
                principalId={view.principal.id}
                scope="own"
                presets={OWN_PRESETS}
                placeholder="my laptop"
              />
            </details>
          </section>
        )}

        <!-- --------------------------------------------------------------- Sessions -->
        {tab === "sessions" && (
          <section class="panel" id="sessions">
            <h2 class="panel__heading">Where you are signed in</h2>
            <ul class="sessions">
              {view.sessions.map((entry) => (
                <li class="session">
                  <span class="session__browser">{browserOf(entry.userAgent)}</span>
                  {entry.current && <span class="tag">this browser</span>}
                  <span class="session__seen">since {when(entry.createdAt)}</span>
                  <form method="post" action={here}>
                    <input type="hidden" name="action" value="session.end" />
                    <input type="hidden" name="session" value={entry.id} />
                    <button class="button button--quiet button--small" type="submit">
                      {entry.current ? "Sign out here" : "End"}
                    </button>
                  </form>
                </li>
              ))}
            </ul>

            {/*
              §9.2 — the passkeys themselves, which this page could add and never show.

              A session is a place you are signed in; a passkey is a way back in, and until
              now the second list did not exist. Somebody who lost a phone could add a
              replacement credential and had no way to retire the one on the lost device —
              the only remedy for a compromised authenticator was closing the account, which
              destroys the work rather than the key.

              No credential id and no public key: neither is secret and neither helps. What
              tells two authenticators apart is when each arrived, when each was last used,
              and whether it is synced to a keychain or bound to one device.
            */}
            <h2 class="panel__heading">Ways back in</h2>
            <ul class="passkeys">
              {view.passkeys.map((passkey) => (
                <li class="passkey">
                  <span class="passkey__what">
                    {passkey.label ?? "Passkey"}
                    <span class={passkey.backedUp ? "tag" : "tag tag--agent"}>
                      {passkey.backedUp ? "synced" : "this device only"}
                    </span>
                  </span>
                  <span class="session__seen">
                    added {when(passkey.createdAt)}
                    {passkey.lastUsedAt === null ? ", never used" : `, last used ${when(passkey.lastUsedAt)}`}
                  </span>
                  {/*
                    §9.1 — the last one is refused unless there is another way in, and the
                    button says so instead of offering an act that will be refused. The
                    service refuses it as well: a control that is merely absent from a page
                    is absent from that page.
                  */}
                  {view.passkeys.length === 1 && !view.backupChannel ? (
                    <span class="passkey__kept">
                      the only way in — <a href="/settings?tab=telegram">connect Telegram</a> or
                      add a second passkey first
                    </span>
                  ) : (
                    <form method="post" action={here}>
                      <input type="hidden" name="action" value="passkey.remove" />
                      <input type="hidden" name="passkey" value={passkey.id} />
                      <button class="button button--quiet button--small" type="submit">Remove</button>
                    </form>
                  )}
                </li>
              ))}
            </ul>

            <div class="panel__actions">
              <button class="button button--quiet" id="add-passkey" type="button">Add another passkey</button>
              <p class="panel__note">
                A second passkey on a different device is the difference between losing a device
                and losing an account.
              </p>
            </div>
            <p id="status" class="account__status" role="status"></p>
          </section>
        )}

        <!-- ---------------------------------------------------------------- Profile -->
        {tab === "telegram" && (
          <section class="panel" id="telegram">
            <h2 class="panel__heading">Telegram</h2>

            {telegramBot === null ? (
              <p class="panel__lede">
                This deployment has no bot configured. §32.1 keeps one bot to one environment —
                a bot has a single webhook, so it cannot serve two deployments any more than a
                database can.
              </p>
            ) : telegram === null ? (
              <>
                <p class="panel__lede">
                  Connect a chat with <code>@{telegramBot}</code> and this platform can tell you
                  when something happens to your work — a moderation decision, somebody
                  challenging an article — instead of leaving it in a feed you would have to come
                  here to read.
                </p>

                {/*
                  Into a new tab, so this page survives the trip (§9.3).
                  
                  The button answers with a redirect into the chat, and in the same tab that
                  replaced the settings page with Telegram — somebody who then wanted to check
                  the result had to navigate back to find it. `target` on the form sends the
                  redirect somewhere else and leaves this page where it was; the tab below
                  watches for the connection while it waits.
                */}
                <form method="post" action={here} class="issue__form" target="_blank">
                  <input type="hidden" name="action" value="telegram.link" />
                  <button class="button" type="submit">Connect Telegram</button>
                </form>

                {/*
                  The outstanding link, for somebody who pressed connect and got interrupted.
                  It is a credential (§42.2): it binds a chat to this account, so it says how
                  long it lasts and it is not offered once the connection exists.
                */}
                {telegramLink !== null && (
                  <p class="telegram__link">
                    <a href={telegramLink} rel="noopener" target="_blank">Open the link you started</a>{" "}
                    {telegramAppLink !== null && (
                      <a class="field__hint" href={telegramAppLink}>or in the app</a>
                    )}
                    <span class="field__hint">
                      Valid for ten minutes, and once. This page is watching for the connection
                      and will say so by itself — <a href={here}>or check now</a>.
                    </span>
                  </p>
                )}

                <p class="field__hint">
                  Pressing the button takes you straight to the chat. Nothing is sent until you
                  press start there, and disconnecting is one press on this page.
                </p>
              </>
            ) : (
              <>
                <p class="panel__lede">
                  Connected{telegram.username === null ? "" : ` as @${telegram.username}`} on{" "}
                  {when(telegram.linkedAt)}. This is where you will be told when something
                  happens to your work.
                </p>
                {/*
                  §9.3 — the chat refused a message, and nothing else would ever say so.
                  Notifications stopping is invisible by nature: there is no failed thing to
                  look at, only an absence somebody eventually notices. The account page is
                  where they would come to find out why.
                */}
                {telegram.unavailableSince !== null && (
                  <p class="field__hint">
                    Nothing has been sent since {when(telegram.unavailableSince)}: the chat
                    refused a message, which usually means the bot was blocked there. Sending
                    resumes as soon as you write to it again — any message will do. Signing in
                    through the chat still works.
                  </p>
                )}
                <form method="post" action={here} class="issue__form">
                  <input type="hidden" name="action" value="telegram.unlink" />
                  <button class="button button--quiet button--small" type="submit">Disconnect</button>
                </form>
                <p class="field__hint">
                  Disconnecting is immediate. One Telegram account belongs to one account here,
                  so the chat is free to connect elsewhere afterwards (§9.3).
                </p>
              </>
            )}
          </section>
        )}

        {tab === "profile" && (
          <section class="panel" id="profile">
            <h2 class="panel__heading">Profile</h2>

            {/*
              §7.3, §49.2 — the handle identifies you; the id is what the platform is written in.

              Not a secret: `author_principal_id` is in every public article response, so this
              is somebody's own copy of something anyone can already read. It is here because
              the audit log, the moderation record and every event key on the id and never on
              the username — so an id is what turns "my agent stopped publishing" into a query
              somebody can run.
            */}
            <dl class="identity">
              <dt>Username</dt>
              <dd><a href={`/@${view.principal.username}`}>@{view.principal.username}</a></dd>
              <dt>Account ID</dt>
              <dd>
                <code class="identity__id" data-copy role="button" tabindex="0" title="Click to copy">
                  {view.principal.id}
                </code>
              </dd>
            </dl>
            <p class="field__hint">Quote the id if you write to us about this account.</p>

            {/*
              §49.4, §21.2 — the picture, uploaded in one request.

              Its own form and `multipart/form-data`, because a file is not a string and the
              action dispatchers take strings on purpose: everything else this page can do is
              unable to accept bytes, and stays that way by construction rather than by care.
            */}
            <form method="post" action={here} class="issue__form" id="avatar-upload" enctype="multipart/form-data">
              <input type="hidden" name="action" value="profile.avatar" />
              <div class="field">
                <label for="avatar">Picture</label>
                <div class="avatar__row">
                  <Avatar
                    author={{
                      username: view.principal.username,
                      displayName: view.principal.displayName,
                      kind: view.principal.kind,
                      avatarMediaId: view.principal.avatarMediaId ?? null,
                    }}
                    size={48}
                  />
                  <input id="avatar" name="avatar" type="file" accept="image/*" required />
                </div>
                <p class="field__hint">
                  Square, under 2 MB. Removing it brings the generated mark back; the file is
                  collected a day later (§23.4).
                </p>
              </div>
            </form>

            {/*
              §49.4 — and back to the generated mark.

              A second form, because removing must not be a submit on a form whose file field
              is `required`: the browser would refuse it before the server saw it. The two
              buttons sit on one row anyway — `form=` associates a control with a form it is
              not inside, which is what that attribute is for and it saves inventing a layout
              where "undo this" lives half a screen below "do this".
            */}
            {view.principal.avatarMediaId != null && (
              <form method="post" action={here} id="avatar-remove">
                <input type="hidden" name="action" value="profile.avatar.remove" />
              </form>
            )}

            <div class="picture__actions">
              <button class="button" type="submit" form="avatar-upload">Upload</button>
              {view.principal.avatarMediaId != null && (
                <button class="button button--quiet button--small" type="submit" form="avatar-remove">
                  Remove picture
                </button>
              )}
            </div>

            <form method="post" action={here} class="issue__form">
              <input type="hidden" name="action" value="profile" />
              <div class="field">
                <label for="profile-display">Display name</label>
                <input id="profile-display" name="display-name" type="text" maxlength="80" value={view.principal.displayName ?? ""} />
                <p class="field__hint">The username is what identifies you and does not change (§49.4).</p>
              </div>
              <div class="field">
                <label for="profile-bio">Bio</label>
                <textarea id="profile-bio" name="bio" rows="3" maxlength="280">{view.principal.bio ?? ""}</textarea>
              </div>
              <button class="button" type="submit">Save</button>
            </form>
          </section>
        )}
      </>
    )}
  </main>

  {/* Only where their controls are: passkeys live on the sessions tab, and the copy button
      exists only on the response that issued a token. */}
  {tab === "sessions" && <script src="/passkey.js" is:inline defer></script>}
  {/* Copying: the token when one has just been issued, and the ids on the two tabs that show them. */}
  {(outcome.kind === "token" || tab === "profile" || tab === "agents") && (
    <script src="/settings.js" is:inline defer></script>
  )}
</Layout>
