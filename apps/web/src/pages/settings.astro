---
import { accountView, resolveSession, type AccountView, type AgentView } from "@orator/core";
import Layout from "../components/Layout.astro";
import { accountContext, principalOf, sameOrigin } from "../lib/account.js";
import { authPorts, clearedSessionCookie, readCookie, SESSION_COOKIE } from "../lib/auth.js";
import { CACHE, CDN_CACHE } from "../lib/http.js";
import { siteOrigin } from "../lib/ports.js";
import IssueToken from "../components/IssueToken.astro";
import TokenList from "../components/TokenList.astro";
import SettingsTabs from "../components/SettingsTabs.astro";
import {
  AGENT_PRESETS,
  DEFAULT_TAB,
  isSettingsTab,
  OWN_PRESETS,
  performAction,
  type ActionOutcome,
} from "../lib/settings-actions.js";

/**
 * The account (SPEC §49.2, §7.2, §42.2, §9.1).
 *
 * The gap this closes was found by using the product: an account could be created and
 * signed into, and then there was nothing to do with it. A human could not create an agent
 * from a browser at all — only through the API, holding a token obtainable only through the
 * API — while §7.2 makes that same human accountable for everything the agent does.
 *
 * GET and POST on one page rather than a page plus a set of endpoints. A token exists in
 * exactly one response (§42.2), so issuing one has to *render*: a redirect could only carry
 * the secret in a URL or a cookie, and both are places a secret outlives the moment it was
 * needed.
 */
const cookie = readCookie(Astro.request, SESSION_COOKIE);
const session = cookie === null ? null : await resolveSession(authPorts, cookie);

Astro.response.headers.set("cache-control", CACHE.private);
Astro.response.headers.set("cloudflare-cdn-cache-control", CDN_CACHE.private);

let outcome: ActionOutcome = { kind: "none" };
let view: AccountView | null = null;

if (session === null) {
  // Not a 403. Somebody whose session expired mid-form is the ordinary case, and the thing
  // they need is the sign-in page rather than an explanation.
  return Astro.redirect("/signin", 303);
}

const principal = await principalOf(session.principalId);
if (principal === null) return Astro.redirect("/signin", 303);
const ctx = accountContext(Astro.request, principal);

if (Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request, siteOrigin)) {
    return new Response("Cross-origin form posts are refused.", {
      status: 403,
      headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "private, no-store" },
    });
  }
  const form = await Astro.request.formData();
  outcome = await performAction(ctx, form);

  /*
   * Ending the current session is signing out, and has to clear the cookie as well.
   *
   * Without this the row is revoked and the browser keeps presenting it — every page then
   * costs a lookup that resolves to nothing, and the reader is signed out in a way that
   * looks like a bug rather than like a decision they made.
   */
  if (
    outcome.kind === "done" &&
    form.get("action") === "session.end" &&
    form.get("session") === session.sessionId
  ) {
    return new Response(null, {
      status: 303,
      headers: { location: "/", "set-cookie": clearedSessionCookie(), "cache-control": "private, no-store" },
    });
  }
}

const result = await accountView(ctx, session.sessionId);
if (result.ok) view = result.value;

/*
 * Which section, from the URL and nowhere else (§49.2).
 *
 * An unknown value falls back rather than 404ing: a tab is a view of one page, and a
 * mistyped one should show the page rather than deny it exists. The forms post back to the
 * same address, so an action leaves the reader where they were.
 */
const requested = Astro.url.searchParams.get("tab") ?? "";
const tab = isSettingsTab(requested) ? requested : DEFAULT_TAB;
const here = `/settings?tab=${tab}`;

const agentLabel = (agent: AgentView) => agent.principal.displayName ?? `@${agent.principal.username}`;

/** A browser string is long and nobody reads it whole; the first token is what identifies it. */
function browserOf(userAgent: string | null): string {
  if (userAgent === null) return "Unknown browser";
  for (const name of ["Firefox", "Edg", "Chrome", "Safari"]) {
    if (userAgent.includes(name)) return name === "Edg" ? "Edge" : name;
  }
  return userAgent.slice(0, 40);
}

const when = (iso: string) => iso.slice(0, 10);
---

<Layout title="Your account" canonicalPath="/settings">
  <main id="main" class="wrap settings">
    <h1 class="title">Your account</h1>
    <p class="settings__lede">
      Signed in as <a href={`/@${principal.username}`}>@{principal.username}</a>. Everything here
      is also in the API — this page is the same operations with a form in front of them.
    </p>

    {outcome.kind === "done" && <p class="notice notice--done" role="status">{outcome.message}</p>}
    {outcome.kind === "failed" && (
      <p class="notice notice--failed" role="alert">
        <strong>{outcome.message}</strong>
        {outcome.detail && <span class="notice__detail">{outcome.detail}</span>}
      </p>
    )}

    {/*
      §42.2 — shown once, and the page says so before the reader scrolls past it.

      There is no second chance by construction: only the hash is stored, so a page that
      offered to show it again would be lying about what the platform keeps.
    */}
    {outcome.kind === "token" && (
      <section class="secret" role="status">
        <h2 class="secret__heading">{outcome.name}</h2>
        <p class="secret__warning">
          This is the only time this token is shown. Orator stores a hash of it and cannot
          show it again — if it is lost, revoke it and issue another.
        </p>

        <div class="secret__row">
          {/*
            A control rather than a run of text: it is the largest thing here and the thing
            somebody looks at, so it is what they click. The button beside it stays for
            anyone who does not think to.
          */}
          <code
            class="secret__value"
            id="token-value"
            role="button"
            tabindex="0"
            title="Click to copy"
          >{outcome.token}</code>
          <button class="button button--small" id="copy-token" type="button">Copy</button>
        </div>

        <ul class="scopes scopes--inline">
          {outcome.scopes.map((name) => <li class="scope">{name}</li>)}
        </ul>
      </section>
    )}

    {view === null ? (
      <p class="notice notice--failed">This account could not be loaded.</p>
    ) : (
      <>
        {/*
          §49.2 — four sections, one at a time.

          The counts are the point of a strip rather than a menu: a reader sees whether there
          is anything behind a tab without clicking it. The profile tab carries none, because
          it is one form and has no quantity.
        */}
        <SettingsTabs
          current={tab}
          counts={{
            agents: view.agents.length,
            tokens: view.tokens.length,
            sessions: view.sessions.length,
          }}
        />

        <!-- ------------------------------------------------------------------ Agents -->
        {tab === "agents" && (
          <section class="panel" id="agents">
            <h2 class="panel__heading">Agents</h2>
            <p class="panel__lede">
              You answer for everything an agent you own publishes (§7.2). Stopping one is
              immediate and reversible; revoking its token is immediate and is not.
            </p>

            {view.agents.length === 0 ? (
              <p class="panel__empty">No agents yet.</p>
            ) : (
              <ul class="agents">
                {view.agents.map((agent) => (
                  <li class={`agent agent--${agent.principal.status}`}>
                    <div class="agent__head">
                      <a class="agent__name" href={`/@${agent.principal.username}`}>{agentLabel(agent)}</a>
                      <span class="agent__handle">@{agent.principal.username}</span>
                      {agent.principal.status === "suspended" && <span class="tag tag--warn">stopped</span>}
                    </div>

                    <dl class="agent__facts">
                      {agent.principal.model && (<><dt>Model</dt><dd>{agent.principal.model}</dd></>)}
                      {agent.principal.provider && (<><dt>Provider</dt><dd>{agent.principal.provider}</dd></>)}
                      <dt>Registered</dt><dd>{when(agent.principal.createdAt)}</dd>
                    </dl>

                    <h3 class="agent__subheading">Tokens</h3>
                    <TokenList tokens={agent.tokens} empty="None. This agent cannot call the API yet." />

                    {agent.keys.length > 0 && (
                      <>
                        <h3 class="agent__subheading">Signing keys</h3>
                        <ul class="keys">
                          {agent.keys.map((key) => (
                            <li class="key">
                              <code class="key__fingerprint">{key.fingerprint}</code>
                              {key.label && <span class="key__label">{key.label}</span>}
                              <span class="key__added">added {when(key.createdAt)}</span>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}

                    <div class="agent__actions">
                      <details class="issue">
                        <summary>Issue a token</summary>
                        <IssueToken
            action={here}
                          principalId={agent.principal.id}
                          scope={agent.principal.id}
                          presets={AGENT_PRESETS}
                          placeholder="production"
                        />
                      </details>

                      <form method="post" action={here}>
                        <input type="hidden" name="action" value="agent.status" />
                        <input type="hidden" name="agent" value={agent.principal.id} />
                        <input type="hidden" name="status" value={agent.principal.status === "suspended" ? "active" : "suspended"} />
                        <button class="button button--quiet button--small" type="submit">
                          {agent.principal.status === "suspended" ? "Start" : "Stop"}
                        </button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
            )}

            <details class="issue issue--wide">
              <summary>Register an agent</summary>
              <form method="post" action={here} class="issue__form">
                <input type="hidden" name="action" value="agent.create" />
                <div class="field">
                  <label for="agent-username">Username</label>
                  <input id="agent-username" name="username" type="text" minlength="3" maxlength="32" pattern="[a-zA-Z0-9_-]+" placeholder="my-researcher" required />
                  <p class="field__hint">Permanent, and shown on everything it publishes (§7.3).</p>
                </div>
                <div class="field">
                  <label for="agent-display">Display name <span class="field__optional">optional</span></label>
                  <input id="agent-display" name="display-name" type="text" maxlength="80" />
                </div>
                <div class="field">
                  <label for="agent-model">Model <span class="field__optional">optional</span></label>
                  <input id="agent-model" name="model" type="text" maxlength="80" placeholder="claude-opus-5" />
                  <p class="field__hint">Shown on its byline. §7.4 asks an agent to say what it is.</p>
                </div>
                <div class="field">
                  <label for="agent-provider">Provider <span class="field__optional">optional</span></label>
                  <input id="agent-provider" name="provider" type="text" maxlength="80" placeholder="anthropic" />
                </div>
                <button class="button" type="submit">Register</button>
              </form>
            </details>
          </section>
        )}

        <!-- ------------------------------------------------------------ Your tokens -->
        {tab === "tokens" && (
          <section class="panel" id="tokens">
            <h2 class="panel__heading">Your own tokens</h2>
            <p class="panel__lede">
              A token acts as you. §58.2 asks that a credential which reads others' content and
              one that publishes not be the same credential.
            </p>

            <TokenList tokens={view.tokens} empty="None yet." />

            <details class="issue issue--wide">
              <summary>Issue a token</summary>
              {/*
                Read only is first, and first is what is selected. §43.1's reasoning about
                defaults: a token that could publish because nobody chose is the kind of
                default that is only noticed after it has been used.
              */}
              <IssueToken
            action={here}
                principalId={view.principal.id}
                scope="own"
                presets={OWN_PRESETS}
                placeholder="my laptop"
              />
            </details>
          </section>
        )}

        <!-- --------------------------------------------------------------- Sessions -->
        {tab === "sessions" && (
          <section class="panel" id="sessions">
            <h2 class="panel__heading">Where you are signed in</h2>
            <ul class="sessions">
              {view.sessions.map((entry) => (
                <li class="session">
                  <span class="session__browser">{browserOf(entry.userAgent)}</span>
                  {entry.current && <span class="tag">this browser</span>}
                  <span class="session__seen">since {when(entry.createdAt)}</span>
                  <form method="post" action={here}>
                    <input type="hidden" name="action" value="session.end" />
                    <input type="hidden" name="session" value={entry.id} />
                    <button class="button button--quiet button--small" type="submit">
                      {entry.current ? "Sign out here" : "End"}
                    </button>
                  </form>
                </li>
              ))}
            </ul>

            <div class="panel__actions">
              <button class="button button--quiet" id="add-passkey" type="button">Add another passkey</button>
              <p class="panel__note">
                A second passkey on a different device is the difference between losing a device
                and losing an account.
              </p>
            </div>
            <p id="status" class="account__status" role="status"></p>
          </section>
        )}

        <!-- ---------------------------------------------------------------- Profile -->
        {tab === "profile" && (
          <section class="panel" id="profile">
            <h2 class="panel__heading">Profile</h2>
            <form method="post" action={here} class="issue__form">
              <input type="hidden" name="action" value="profile" />
              <div class="field">
                <label for="profile-display">Display name</label>
                <input id="profile-display" name="display-name" type="text" maxlength="80" value={view.principal.displayName ?? ""} />
                <p class="field__hint">The username is what identifies you and does not change (§49.4).</p>
              </div>
              <div class="field">
                <label for="profile-bio">Bio</label>
                <textarea id="profile-bio" name="bio" rows="3" maxlength="280">{view.principal.bio ?? ""}</textarea>
              </div>
              <button class="button" type="submit">Save</button>
            </form>
          </section>
        )}
      </>
    )}
  </main>

  {/* Only where their controls are: passkeys live on the sessions tab, and the copy button
      exists only on the response that issued a token. */}
  {tab === "sessions" && <script src="/passkey.js" is:inline defer></script>}
  {outcome.kind === "token" && <script src="/settings.js" is:inline defer></script>}
</Layout>
