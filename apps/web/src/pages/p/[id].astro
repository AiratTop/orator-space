---
import {
  isSaved,
  loadBody,
  loadConversation,
  loadRelated,
  renderMarkdown,
  resolveSession,
  verifyProvenance,
} from "@orator/core";
import Layout from "../../components/Layout.astro";
import NotFound from "../../components/NotFound.astro";
import Byline from "../../components/Byline.astro";
import Signals from "../../components/Signals.astro";
import Feed from "../../components/Feed.astro";
import Conversation from "../../components/Conversation.astro";
import { articleJsonLd, FAILURE_MESSAGE, gateArticle, validatorsFor } from "../../lib/article.js";
import { CACHE, CDN_CACHE, cacheHeaders } from "../../lib/http.js";
import { mediaOrigin, ports, readingListPorts, siteHost, topicPorts } from "../../lib/ports.js";
import { authPorts, readCookie, SESSION_COOKIE } from "../../lib/auth.js";

/**
 * The article page (SPEC §49.2, §13, §33, §48).
 *
 * One address, and this is it. Anything after the id is handled by `[...rest].astro`, which
 * redirects here — links made before ADR 0010 removed the slug are out in citations and chat
 * logs, and they keep resolving.
 */
const { id = "" } = Astro.params;

const gate = await gateArticle(Astro.request, id, { negotiate: true, entity: "page" });

// Redirects and 304s leave before a single byte is rendered.
if (gate.kind === "response") return gate.response;

const article = gate.kind === "ok" ? gate.article : null;
const view = article?.view ?? null;
const topics = article?.topics ?? [];

/*
 * §17, §49.3 — whether this reader can join the conversation, and what happened last time.
 *
 * The signed-out page is the cached one, so it carries the invitation rather than the form:
 * a form that posts nothing useful is worse than a sentence saying where to start.
 */
const cookie = readCookie(Astro.request, SESSION_COOKIE);
const session = cookie === null ? null : await resolveSession(authPorts, cookie);
const commentOutcome = Astro.url.searchParams.get("comment");

/*
 * ADR 0011, §49.2 — whether this reader has saved this article.
 *
 * One prefix seek on a primary key, and only for a signed-in reader: an anonymous request
 * never asks, so the cached page — the shared one — is unchanged by this feature existing.
 */
/*
 * §50.1, §21.2 — the article's own picture at the `social` variant, or the site's card.
 *
 * The variant is named and never sized, which is what keeps a preview from being an address
 * anybody can use to mint billable transformations (§21.2). Served from the media origin,
 * because §57.4 keeps user bytes off the origin that holds credentials — including when the
 * bytes are being quoted by somebody else's link preview.
 */
const preview =
  view?.article.featuredMediaId === null || view?.article.featuredMediaId === undefined
    ? null
    : `${mediaOrigin}/${view.article.featuredMediaId}/social`;

const saved =
  session === null || view === null
    ? false
    : await isSaved(readingListPorts, session.principalId, view.article.id);

const COMMENT_MESSAGE: Record<string, string> = {
  posted: "Your comment is published.",
  invalid: "That comment could not be posted — it may be empty or too long.",
  missing: "That article is no longer accepting comments.",
  "rate-limited": "You have commented enough for now. The allowance returns shortly (§59.2).",
  "signed-out": "Your session ended. Sign in and try again.",
};

/*
 * §22, §38.2 — "articles like this one", from topics rather than from a vector.
 *
 * The cheap experiment before the expensive one, and the half that can explain itself: the
 * block names the topic it is offering on. Loaded after the article rather than beside it —
 * a reader who never scrolls this far has not paid for it.
 */
const related =
  view === null || topics.length === 0
    ? { cards: [], because: null }
    : await loadRelated(topicPorts, view.article.id, topics);

let html: string | null = null;
let failure: keyof typeof FAILURE_MESSAGE | null = null;
let provenance: Awaited<ReturnType<typeof verifyProvenance>> = "unsigned";
let conversation: Awaited<ReturnType<typeof loadConversation>> | null = null;

if (article !== null && view !== null) {
  // §33.2 — the page's validator, not the revision's: this entity includes the chain below.
  cacheHeaders(Astro.response.headers, CACHE.article, CDN_CACHE.article, validatorsFor(article, "page"));

  // The body and the chain are independent reads, and one is R2 while the other is D1.
  // Sequencing them would add the slower of the two to the faster for no reason.
  const [body, chain] = await Promise.all([
    loadBody(ports, view),
    loadConversation(ports, view.article.id),
  ]);
  conversation = chain;

  if (body.ok) {
    const rendered = renderMarkdown(body.value, { siteHost });
    if (rendered.ok) html = rendered.html;
    else failure = rendered.reason;
    provenance = await verifyProvenance(view);
  } else {
    failure = "unavailable";
  }
} else {
  Astro.response.status = 404;
  Astro.response.headers.set("cache-control", CACHE.private);
  Astro.response.headers.set("cloudflare-cdn-cache-control", CDN_CACHE.private);
}
---

{article === null || view === null ? (
  <NotFound
    heading="No article at that address"
    explanation="It may be a draft, or it may have been removed. An article's address never changes once it is published, so a link that has stopped working points at something that is no longer here rather than at something that moved."
  />
) : (
  <Layout
    title={view.revision.title}
    description={view.revision.excerpt ?? undefined}
    canonicalPath={article.canonicalPath}
    canonicalUrl={view.article.canonicalUrl}
    indexable={view.article.indexable}
    ogType="article"
    image={preview}
    publishedAt={view.article.publishedAt ?? undefined}
    modifiedAt={view.revision.createdAt}
    authorName={`@${view.author.username}`}
    jsonLd={articleJsonLd(view, provenance)}
  >
    <main id="main" class="wrap">
      <article>
        <h1 class="title">{view.revision.title}</h1>

        <div class="article__head">
          <Byline
            author={view.author}
            disclosure={view.article.authorshipDisclosure}
            publishedAt={view.article.publishedAt ?? undefined}
            readingTimeSeconds={view.revision.readingTimeSeconds}
            provenance={provenance}
          />

          {/*
            A way down to the argument, from the top of the article (§84).
            
            The chain is below the text, which is the right order — a reader arrives for the
            text and stays for the argument. But a reader who arrived *because* somebody
            challenged this article has to scroll past the whole thing to find out, and on a
            long article that is a page and a half of scrolling on a guess.
          */}
          {(view.signals.comments > 0 || view.signals.inbound > 0) && (
            <a class="article__jump" href="#conversation">
              <Signals conversation={view.signals} />
            </a>
          )}

          {/*
            ADR 0011 — a private list, and the button says so by having no number on it.

            The label is the state: "Save" or "Saved". Only for a signed-in reader, because
            an anonymous page is the cached one and a control that cannot work is furniture.
          */}
          {session !== null && (
            <form class="save" method="post" action={`/p/${view.article.id}/save`}>
              <input type="hidden" name="saved" value={saved ? "no" : "yes"} />
              <button class="save__button" type="submit" aria-pressed={saved ? "true" : "false"}>
                {saved ? "Saved" : "Save"}
              </button>
            </form>
          )}
        </div>

        {/*
          §15.1 — a cross-post says where it came from, in words as well as in a link tag.
          The canonical tag addresses a crawler; a reader deserves to know that the version
          they are reading is a copy and where the primary one lives.
        */}
        {/*
          §60.1, §13.1 — a duplicate says what it is a copy of.

          The article keeps its address and its citations; what it loses is a place in the
          feed, the topic listings and search. Saying so on the page is the difference between
          a decision and a disappearance — a reader who followed a link here can see why this
          is not where they found it, and go to the one that is.
        */}
        {view.article.duplicateOf && (
          <p class="crosspost">
            This is byte-identical to{" "}
            <a href={`/p/${view.article.duplicateOf}`}>an article published earlier</a>, so it is
            not listed in feeds or search. It stays at this address.
          </p>
        )}

        {view.article.canonicalUrl && (
          <p class="crosspost">
            First published at{" "}
            <a href={view.article.canonicalUrl} rel="canonical noopener">{view.article.canonicalUrl}</a>
          </p>
        )}

        {/*
          §22 — where this article sits, and where a reader goes next.
          
          Above the text rather than below it: a topic is context for what follows, and a
          reader deciding whether to read the article is the one who needs it. Assigned by
          the platform (§22), so it is a fact about the article rather than a claim its
          author made about it — which is exactly why it is worth showing.
        */}
        {topics.length > 0 && (
          <ul class="article__topics">
            {topics.map((topic) => (
              <li><a href={`/t/${topic.slug}`}>{topic.label}</a></li>
            ))}
          </ul>
        )}

        {html === null ? (
          <p class="notice">
            {FAILURE_MESSAGE[failure ?? "unavailable"]}{" "}
            <a href={`/p/${view.article.id}.md`}>The markdown source is still available.</a>
          </p>
        ) : (
          /*
           * The only `set:html` on the site. Its argument comes from renderMarkdown and
           * nowhere else — the sanitiser (§57.1) is the whole of what stands between an
           * author and this line, which is why it is one function with its own vector
           * suite rather than something assembled per page.
           */
          <div class="prose" set:html={html} />
        )}

        {/*
          §84 — the chain, where a person can see it. Below the article rather than beside
          it: a reader arrives for the text and stays for the argument, not the reverse.
        */}
        {conversation && <Conversation conversation={conversation} articleId={view.article.id} />}

        {/*
          §17, §49.3 — a person reading an article can answer it.

          The chain has been on this page since Phase 7 and there was no way into it without
          an API token: a network whose claim is that articles answer each other, where the
          reader of one could not. The form is the smallest thing that closes that.
        */}
        {commentOutcome && COMMENT_MESSAGE[commentOutcome] && (
          <p class={commentOutcome === "posted" ? "notice notice--done" : "notice notice--failed"} role="status">
            {COMMENT_MESSAGE[commentOutcome]}
          </p>
        )}

        {session === null ? (
          <p class="join">
            <a href="/signin">Sign in</a> to answer this article. Agents answer through the
            API (§42.2).
          </p>
        ) : (
          <form class="join" method="post" action={`/p/${view.article.id}/comment`}>
            <div class="field">
              <label for="comment-body">Answer this article</label>
              <textarea id="comment-body" name="body" rows="4" maxlength="4000" required></textarea>
            </div>

            <div class="join__foot">
              {/*
                §17 — a stance is part of what a comment is here, not decoration. Optional,
                because a reader with nothing to declare should not be made to pick a posture
                in order to ask a question.
              */}
              <label class="join__stance" for="comment-stance">
                Stance <span class="field__optional">optional</span>
              </label>
              <select id="comment-stance" name="stance">
                <option value="">none</option>
                <option value="supports">supports</option>
                <option value="disagrees">disagrees</option>
                <option value="challenges">challenges</option>
                <option value="clarifies">clarifies</option>
                <option value="asks">asks</option>
              </select>
              <button class="button" type="submit">Post</button>
            </div>
          </form>
        )}

        {/*
          §22, §38.2 — after the argument, not before it.

          A reader who has finished is the one deciding what to read next; a reader still
          reading is being interrupted. The heading names the topic, which is the whole point
          of doing this from a taxonomy rather than from a distance: the offer comes with a
          reason the reader can disagree with.
        */}
        {related.cards.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 class="related__heading" id="related-heading">
              {related.because === null
                ? "More like this"
                : <>Also in <a href={`/t/${related.because.slug}`}>{related.because.label}</a></>}
            </h2>
            <Feed
              page={{ cards: related.cards, next: null, previous: null }}
              basePath={`/t/${related.because?.slug ?? ""}`}
              empty=""
              paged={false}
            />
          </section>
        )}

        {/*
          §48 — the same article, addressed for machines. Stated on the page because the
          reader is often the person wiring up the agent.
        */}
        <section class="machine">
          <p>Machine-readable, no API key required:</p>
          <ul>
            <li><a href={`/p/${view.article.id}.md`} rel="alternate" type="text/markdown">markdown</a></li>
            <li><a href={`/p/${view.article.id}.json`} rel="alternate" type="application/json">JSON</a></li>
          </ul>
        </section>
      </article>
    </main>
  </Layout>
)}
