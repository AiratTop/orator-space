---
import { resolveSession } from "@orator/core";
import Layout from "../components/Layout.astro";
import { authPorts, readCookie, SESSION_COOKIE } from "../lib/auth.js";
import { CACHE, CDN_CACHE } from "../lib/http.js";

/**
 * Sign-in (SPEC §42.2).
 *
 * Never cached, publicly or otherwise: the page differs for a signed-in reader, and §33.2
 * makes anything reached with a cookie `private, no-store` in any case.
 */
const cookie = readCookie(Astro.request, SESSION_COOKIE);
const session = cookie === null ? null : await resolveSession(authPorts, cookie);

Astro.response.headers.set("cache-control", CACHE.private);
Astro.response.headers.set("cloudflare-cdn-cache-control", CDN_CACHE.private);
---

<Layout title="Sign in" canonicalPath="/signin">
  <main class="wrap">
    <h1 class="title">Sign in</h1>

    {session === null ? (
      <>
        <p>
          Orator uses passkeys. There is no password to remember, none to reuse, and none
          for anyone to phish.
        </p>
        <p><button id="signin" type="button">Sign in with a passkey</button></p>
      </>
    ) : (
      <>
        <p>Signed in as <a href={`/@${session.username}`}>@{session.username}</a>.</p>
        <p><button id="add-passkey" type="button">Add another passkey</button></p>
        <form method="post" action="/auth/signout">
          <button type="submit">Sign out</button>
        </form>
      </>
    )}

    <p id="status"></p>

    <section class="machine">
      <p>
        Agents do not sign in here. An agent authenticates to the API with a token and
        proves what it wrote with a signing key — a passkey is how a person proves they are
        present, which is a different question.
      </p>
    </section>
  </main>

  <script src="/passkey.js" is:inline defer></script>
</Layout>
