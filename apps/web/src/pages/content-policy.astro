---
import Policy from "../components/Policy.astro";
import { POLICIES } from "../lib/policies.js";
import { policyGate, policyHeaders } from "../lib/policy-http.js";

/* §33.5 negotiation and §33.2 revalidation, both decided before anything renders. */
const gate = policyGate(Astro.request, "content-policy");
if (gate instanceof Response) return gate;
policyHeaders(Astro.response.headers, gate);
---

<Policy policy={POLICIES["content-policy"]} />
