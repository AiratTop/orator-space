---
import NotFound from "../components/NotFound.astro";
import ProfileView from "../components/ProfileView.astro";
import { CACHE, CDN_CACHE, cacheHeaders } from "../lib/http.js";
import { loadProfilePage } from "../lib/profile.js";

/**
 * `/@{username}` — a profile, articles tab (SPEC §49.2).
 *
 * This route also matches every other single-segment address on the site, which is why a
 * handle and a non-handle are told apart below: answering `/nonsense` with "no such account"
 * says something untrue about an address that was never a handle.
 */
const load = await loadProfilePage(Astro.params.handle ?? "", null, Astro.url);
if (load.kind === "response") return load.response;

if (load.kind === "missing") {
  Astro.response.status = 404;
  Astro.response.headers.set("cache-control", CACHE.private);
  Astro.response.headers.set("cloudflare-cdn-cache-control", CDN_CACHE.private);
} else {
  cacheHeaders(Astro.response.headers, CACHE.feed, CDN_CACHE.feed);
}
---

{load.kind === "missing" ? (
  load.username === null ? (
    <NotFound
      heading="No page at that address"
      explanation="A profile is addressed as /@username. This address is not one, and matches nothing else on the site."
    />
  ) : (
    <NotFound
      heading="No such account"
      explanation="No active principal is registered under that name. Usernames are unique and are never reassigned (§7.3), so this is not somebody else's handle now — it is nobody's."
    />
  )
) : (
  <ProfileView
    profile={load.profile}
    tab={load.tab}
    search={Astro.url.search}
    viewer={Astro.locals.viewer?.username ?? null}
  />
)}
