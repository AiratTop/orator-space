{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orator-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,

  // Placeholder bindings for `wrangler dev`; every environment overrides them below.
  "vars": { "ENVIRONMENT": "local", "SITE_HOST": "localhost" },
  "d1_databases": [{ "binding": "DB", "database_name": "orator-staging", "database_id": "125c0049-a2ad-4814-a2fa-59d6ea7d86a9", "migrations_dir": "../../packages/db/migrations" }],
  "r2_buckets": [
    { "binding": "CONTENT", "bucket_name": "orator-content-staging" },
    { "binding": "MEDIA", "bucket_name": "orator-media-staging" },
    { "binding": "ASSETS_BUCKET", "bucket_name": "orator-assets-staging" }
  ],
  // The consumer is declared at the top level too, so `wrangler dev` runs the whole
  // pipeline locally rather than only the half that produces messages. Without it the
  // queue handler is never exercised until it reaches a deployed environment.
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "orator-events-staging" }],
    "consumers": [
      {
        "queue": "orator-events-staging",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "orator-events-staging-dlq"
      }
    ]
  },
  /*
   * SPEC §59.1 — the exact half of the two limiting mechanisms.
   *
   * One object per principal, so "20 articles a day" means twenty, not twenty per colo.
   * `new_sqlite_classes` rather than `new_classes`: the SQLite-backed storage is the
   * current default for new namespaces and is what the Phase −1 spike verified.
   */
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],

  /*
   * SPEC §59.1 — the approximate half: per-colo flood protection.
   *
   * Two namespaces because the binding's limit is fixed per binding and §59.2 names two
   * different numbers: 600 API requests a minute, and 60 searches. Approximate is fine
   * here — a distributed caller bypasses a per-colo counter, and for flood protection that
   * is acceptable in a way it is not for a quota.
   */
  "ratelimits": [
    { "name": "FLOOD", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "FLOOD_SEARCH", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  /*
   * SPEC §66.2 — metrics go here and never to D1.
   *
   * Writing a view to D1 would turn the most frequent operation in a read-heavy system into
   * a write, and would not work anyway: a cached response never reaches the Worker, so the
   * counter would not move (§33.6). `article_stats` is filled from this dataset on a
   * schedule instead. Not inherited by an environment, so each names its own below.
   */
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "orator_metrics_staging" }],

  "triggers": {
    /*
     * Three schedules, and `event.cron` says which fired.
     *
     * Every minute is the outbox safety net (§35.2) — a direct send that was dropped costs
     * a minute of delay rather than sitting there. Every five minutes rebuilds whichever
     * sitemap shards were marked dirty, which is §51's batch. Retention (§23.4) is daily
     * and at an odd time: nothing about it is urgent, and a cleanup that runs on the hour
     * competes with every other cron on the platform for the same D1.
     */
    "crons": ["* * * * *", "*/5 * * * *", "17 4 * * *"]
  },

  "env": {
    "staging": {
      "name": "orator-edge-staging",
      "vars": { "ENVIRONMENT": "staging", "SITE_HOST": "staging.orator.space" },
      "routes": [
        { "pattern": "api-staging.orator.space", "custom_domain": true },
        { "pattern": "mcp-staging.orator.space", "custom_domain": true },
        { "pattern": "media-staging.orator.space", "custom_domain": true }
      ],
      "d1_databases": [{ "binding": "DB", "database_name": "orator-staging", "database_id": "125c0049-a2ad-4814-a2fa-59d6ea7d86a9", "migrations_dir": "../../packages/db/migrations" }],
      "r2_buckets": [
        { "binding": "CONTENT", "bucket_name": "orator-content-staging" },
        { "binding": "MEDIA", "bucket_name": "orator-media-staging" },
        { "binding": "ASSETS_BUCKET", "bucket_name": "orator-assets-staging" }
      ],
      "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],
      "ratelimits": [
        { "name": "FLOOD", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
        { "name": "FLOOD_SEARCH", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "orator_metrics_staging" }],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "orator-events-staging" }],
        "consumers": [
          {
            "queue": "orator-events-staging",
            "max_batch_size": 25,
            "max_batch_timeout": 10,
            "max_retries": 5,
            "dead_letter_queue": "orator-events-staging-dlq"
          }
        ]
      },
      "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "17 4 * * *"]
  }
    },

    "production": {
      "name": "orator-edge",
      "vars": { "ENVIRONMENT": "production", "SITE_HOST": "orator.space" },
      "routes": [
        { "pattern": "api.orator.space", "custom_domain": true },
        { "pattern": "mcp.orator.space", "custom_domain": true },
        { "pattern": "media.orator.space", "custom_domain": true }
      ],
      "d1_databases": [{ "binding": "DB", "database_name": "orator-prod", "database_id": "eb98f063-21b0-451d-9372-a2105169ca9b", "migrations_dir": "../../packages/db/migrations" }],
      "r2_buckets": [
        { "binding": "CONTENT", "bucket_name": "orator-content" },
        { "binding": "MEDIA", "bucket_name": "orator-media" },
        { "binding": "ASSETS_BUCKET", "bucket_name": "orator-assets" }
      ],
      "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],
      "ratelimits": [
        { "name": "FLOOD", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
        { "name": "FLOOD_SEARCH", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "orator_metrics" }],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "orator-events" }],
        "consumers": [
          {
            "queue": "orator-events",
            "max_batch_size": 25,
            "max_batch_timeout": 10,
            "max_retries": 5,
            "dead_letter_queue": "orator-events-dlq"
          }
        ]
      },
      "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "17 4 * * *"]
  }
    }
  }
}
