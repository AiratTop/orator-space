[
  ["allow", "git commit -F - <<'MSG'\nA deploy named staging\n\n    pnpm --filter @orator/web exec wrangler deploy --env staging\n\nreached production. This is a message, not a command.\nMSG"],
  ["deny", "pnpm --filter @orator/web exec wrangler deploy --env staging"],
  ["deny", "pnpm --filter @orator/web deploy:production"],
  ["deny", "pnpm --filter @orator/edge deploy:production"],
  ["deny", "npx wrangler rollback 67119438 --name orator-web"],
  ["deny", "npx wrangler deploy"],
  ["deny", "npx wrangler deploy --env production"],
  ["deny", "npx wrangler secret put TELEGRAM_BOT_TOKEN --env staging"],
  ["deny", "npx wrangler d1 migrations apply DB --remote"],
  ["deny", "npx wrangler d1 execute orator-prod --remote --command \"select 1\""],
  ["deny", "wrangler deploy -c dist/server/wrangler.json"],
  ["deny", "npx wrangler vectorize delete orator-articles"],
  ["allow", "pnpm --filter @orator/web deploy:staging"],
  ["allow", "pnpm --filter @orator/edge deploy:staging"],
  ["allow", "cd apps/edge && npx wrangler deploy --env staging"],
  ["allow", "npx wrangler deploy --env staging --dry-run"],
  ["allow", "npx wrangler d1 migrations apply DB --env staging --remote"],
  ["allow", "npx wrangler d1 migrations apply DB --local"],
  ["allow", "npx wrangler tail --name orator-edge"],
  ["allow", "npx wrangler deployments list --name orator-web"],
  ["allow", "npx wrangler vectorize list"],
  ["allow", "pnpm check"],
  ["allow", "git log --oneline -3"]
]
